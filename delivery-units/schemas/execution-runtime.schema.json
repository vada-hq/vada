{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vada.local/schemas/execution-runtime-0.1.0.json",
  "title": "VADA Delivery Execution Runtime",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "runtime_id",
    "runtime_revision",
    "runtime_status",
    "updated_at",
    "delivery_unit_id",
    "execution_plan_ref",
    "sources",
    "work_runs"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "runtime_id": { "type": "string", "pattern": "^RUN-[A-Z0-9][A-Z0-9-]{2,}$" },
    "runtime_revision": { "type": "integer", "minimum": 1 },
    "runtime_status": { "enum": ["active", "completed"] },
    "updated_at": { "type": "string", "format": "date-time" },
    "delivery_unit_id": { "type": "string", "pattern": "^DU-[0-9]{3,}$" },
    "execution_plan_ref": { "$ref": "#/$defs/executionPlanRef" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source" }
    },
    "work_runs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/workRun" }
    }
  },
  "$defs": {
    "status": { "enum": ["not_started", "in_progress", "review", "done", "paused"] },
    "sourceId": { "type": "string", "pattern": "^SRC-RUN-[0-9]{3,}$" },
    "workId": { "type": "string", "pattern": "^WORK:[a-z0-9][a-z0-9.-]*@R[1-9][0-9]*$" },
    "executorId": { "type": "string", "pattern": "^EXEC:[a-z0-9][a-z0-9.-]*$" },
    "executionPlanRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "execution_plan_id", "execution_plan_revision", "canonical_sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "execution_plan_id": { "type": "string", "pattern": "^EP-[A-Z0-9][A-Z0-9-]{2,}$" },
        "execution_plan_revision": { "type": "integer", "minimum": 1 },
        "canonical_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "captured_at", "locator", "content_ko"],
      "properties": {
        "id": { "$ref": "#/$defs/sourceId" },
        "type": {
          "enum": ["approved_artifact", "user_statement", "command_output", "code_evidence", "review_record"]
        },
        "captured_at": { "type": "string", "format": "date-time" },
        "locator": { "type": "string", "minLength": 1 },
        "content_ko": { "type": "string", "minLength": 1 }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from", "to", "occurred_at", "actor_ref", "source_ref", "note_ko"],
      "properties": {
        "id": { "type": "string", "pattern": "^TR-[0-9]{3,}$" },
        "from": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/status" }] },
        "to": { "$ref": "#/$defs/status" },
        "occurred_at": { "type": "string", "format": "date-time" },
        "actor_ref": { "$ref": "#/$defs/executorId" },
        "source_ref": { "$ref": "#/$defs/sourceId" },
        "note_ko": { "type": "string", "minLength": 1 }
      }
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "description_ko", "opened_at", "resolved_at", "source_ref"],
      "properties": {
        "id": { "type": "string", "pattern": "^BLK-[0-9]{3,}$" },
        "status": { "enum": ["open", "resolved"] },
        "description_ko": { "type": "string", "minLength": 1 },
        "opened_at": { "type": "string", "format": "date-time" },
        "resolved_at": { "oneOf": [{ "type": "null" }, { "type": "string", "format": "date-time" }] },
        "source_ref": { "$ref": "#/$defs/sourceId" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "requirement_ref",
        "kind",
        "locator",
        "captured_at",
        "verification_status",
        "verified_by",
        "verified_at",
        "verification_note_ko"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^PROOF-[0-9]{3,}$" },
        "requirement_ref": { "type": "string", "pattern": "^EVID-[0-9]{3,}$" },
        "kind": { "enum": ["automated_test", "reviewed_artifact", "security_check", "accessibility_check", "operational_check"] },
        "locator": { "type": "string", "minLength": 1 },
        "captured_at": { "type": "string", "format": "date-time" },
        "verification_status": { "enum": ["submitted", "verified", "rejected"] },
        "verified_by": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/executorId" }] },
        "verified_at": { "oneOf": [{ "type": "null" }, { "type": "string", "format": "date-time" }] },
        "verification_note_ko": { "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }] }
      }
    },
    "workRun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "work_item_ref",
        "executor_ref",
        "status",
        "started_at",
        "completed_at",
        "transition_log",
        "blockers",
        "evidence_instances"
      ],
      "properties": {
        "work_item_ref": { "$ref": "#/$defs/workId" },
        "executor_ref": { "$ref": "#/$defs/executorId" },
        "status": { "$ref": "#/$defs/status" },
        "started_at": { "oneOf": [{ "type": "null" }, { "type": "string", "format": "date-time" }] },
        "completed_at": { "oneOf": [{ "type": "null" }, { "type": "string", "format": "date-time" }] },
        "transition_log": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/transition" }
        },
        "blockers": { "type": "array", "items": { "$ref": "#/$defs/blocker" } },
        "evidence_instances": { "type": "array", "items": { "$ref": "#/$defs/evidence" } }
      }
    }
  }
}
