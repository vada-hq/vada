{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vada.local/schemas/execution-plan-0.1.0.json",
  "title": "VADA Delivery Execution Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "execution_plan_id",
    "execution_plan_revision",
    "execution_plan_status",
    "approval_source_ref",
    "updated_at",
    "delivery_unit_id",
    "work_plan_ref",
    "objective_ko",
    "sources",
    "satisfied_prerequisites",
    "planning_policy",
    "orchestration",
    "executors",
    "work_allocations",
    "questions"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "execution_plan_id": { "type": "string", "pattern": "^EP-[A-Z0-9][A-Z0-9-]{2,}$" },
    "execution_plan_revision": {
      "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 1 }]
    },
    "execution_plan_status": { "enum": ["planning", "review_ready", "approved"] },
    "approval_source_ref": {
      "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^SRC-[0-9]{3,}$" }]
    },
    "updated_at": { "type": "string", "format": "date-time" },
    "delivery_unit_id": { "type": "string", "pattern": "^DU-[0-9]{3,}$" },
    "work_plan_ref": { "$ref": "#/$defs/workPlanRef" },
    "objective_ko": { "type": "string", "minLength": 1 },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source" }
    },
    "satisfied_prerequisites": {
      "type": "array",
      "items": { "$ref": "#/$defs/satisfiedPrerequisite" }
    },
    "planning_policy": { "$ref": "#/$defs/planningPolicy" },
    "orchestration": { "$ref": "#/$defs/orchestration" },
    "executors": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/executor" }
    },
    "work_allocations": {
      "type": "array",
      "items": { "$ref": "#/$defs/workAllocation" }
    },
    "questions": {
      "type": "array",
      "items": { "$ref": "#/$defs/question" }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "execution_plan_status": { "const": "approved" } },
        "required": ["execution_plan_status"]
      },
      "then": {
        "properties": {
          "execution_plan_revision": { "type": "integer", "minimum": 1 },
          "approval_source_ref": { "type": "string", "pattern": "^SRC-[0-9]{3,}$" }
        }
      },
      "else": {
        "properties": {
          "execution_plan_revision": { "type": "null" },
          "approval_source_ref": { "type": "null" }
        }
      }
    }
  ],
  "$defs": {
    "sourceId": { "type": "string", "pattern": "^SRC-[0-9]{3,}$" },
    "workId": { "type": "string", "pattern": "^WORK:[a-z0-9][a-z0-9.-]*@R[1-9][0-9]*$" },
    "executorId": { "type": "string", "pattern": "^EXEC:[a-z0-9][a-z0-9.-]*$" },
    "capability": {
      "enum": [
        "product_definition",
        "experience_design",
        "technical_design",
        "frontend",
        "backend",
        "quality",
        "platform",
        "security",
        "documentation"
      ]
    },
    "workPlanRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "plan_id", "plan_revision", "canonical_sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "plan_id": { "type": "string", "pattern": "^WP-[A-Z0-9][A-Z0-9-]{2,}$" },
        "plan_revision": { "type": "integer", "minimum": 1 },
        "canonical_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "captured_at", "locator", "content_ko"],
      "properties": {
        "id": { "$ref": "#/$defs/sourceId" },
        "type": {
          "enum": ["user_statement", "approved_artifact", "repository_evidence", "command_output", "standard"]
        },
        "captured_at": { "type": "string", "format": "date-time" },
        "locator": { "type": "string", "minLength": 1 },
        "content_ko": { "type": "string", "minLength": 1 }
      }
    },
    "satisfiedPrerequisite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["work_item_ref", "evidence_locator", "source_refs"],
      "properties": {
        "work_item_ref": { "$ref": "#/$defs/workId" },
        "evidence_locator": { "type": "string", "minLength": 1 },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sourceId" }
        }
      }
    },
    "targetWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_date", "end_date"],
      "properties": {
        "start_date": { "type": "string", "format": "date" },
        "end_date": { "type": "string", "format": "date" }
      }
    },
    "planningPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope_mode",
        "estimate_mode",
        "estimate_unit",
        "schedule_mode",
        "target_window",
        "rationale_ko",
        "source_refs"
      ],
      "properties": {
        "scope_mode": { "enum": ["undetermined", "rolling_wave", "full_unit", "custom"] },
        "estimate_mode": { "enum": ["undetermined", "range", "none"] },
        "estimate_unit": { "enum": ["undetermined", "hours", "ideal_days", "points", "not_applicable"] },
        "schedule_mode": { "enum": ["undetermined", "none", "target_window"] },
        "target_window": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/targetWindow" }]
        },
        "rationale_ko": { "type": "string", "minLength": 1 },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sourceId" }
        }
      }
    },
    "orchestration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "human_approver_ref",
        "coordinator_executor_ref",
        "verifier_executor_refs",
        "worker_isolation",
        "parallelism_mode",
        "max_parallel_workers",
        "independent_verification_required",
        "rationale_ko",
        "source_refs"
      ],
      "properties": {
        "human_approver_ref": { "$ref": "#/$defs/executorId" },
        "coordinator_executor_ref": { "$ref": "#/$defs/executorId" },
        "verifier_executor_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/executorId" }
        },
        "worker_isolation": { "const": "git_worktree" },
        "parallelism_mode": { "const": "dependency_frontier" },
        "max_parallel_workers": {
          "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 1 }]
        },
        "independent_verification_required": { "const": true },
        "rationale_ko": { "type": "string", "minLength": 1 },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sourceId" }
        }
      }
    },
    "availability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "capacity_value", "capacity_unit", "available_from", "available_until"],
      "properties": {
        "status": { "enum": ["known", "unknown"] },
        "capacity_value": {
          "oneOf": [{ "type": "null" }, { "type": "number", "exclusiveMinimum": 0 }]
        },
        "capacity_unit": {
          "oneOf": [{ "type": "null" }, { "enum": ["hours_per_week", "ideal_days_per_week"] }]
        },
        "available_from": {
          "oneOf": [{ "type": "null" }, { "type": "string", "format": "date" }]
        },
        "available_until": {
          "oneOf": [{ "type": "null" }, { "type": "string", "format": "date" }]
        }
      }
    },
    "executor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "display_name", "execution_roles", "capabilities", "availability", "source_refs"],
      "properties": {
        "id": { "$ref": "#/$defs/executorId" },
        "kind": { "enum": ["human", "ai_agent", "team"] },
        "display_name": { "type": "string", "minLength": 1 },
        "execution_roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["accountable_owner", "coordinator", "worker", "verifier"] }
        },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/capability" }
        },
        "availability": { "$ref": "#/$defs/availability" },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sourceId" }
        }
      }
    },
    "estimate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "low", "high", "unit", "basis_ko", "source_refs"],
      "properties": {
        "status": { "enum": ["unknown", "range", "not_applicable"] },
        "low": {
          "oneOf": [{ "type": "null" }, { "type": "number", "exclusiveMinimum": 0 }]
        },
        "high": {
          "oneOf": [{ "type": "null" }, { "type": "number", "exclusiveMinimum": 0 }]
        },
        "unit": { "enum": ["undetermined", "hours", "ideal_days", "points", "not_applicable"] },
        "basis_ko": {
          "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }]
        },
        "source_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sourceId" }
        }
      }
    },
    "workAllocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "work_item_ref",
        "disposition",
        "primary_executor_ref",
        "collaborator_refs",
        "estimate",
        "target_window",
        "rationale_ko",
        "source_refs"
      ],
      "properties": {
        "work_item_ref": { "$ref": "#/$defs/workId" },
        "disposition": { "enum": ["unplanned", "committed", "forecast", "deferred", "satisfied"] },
        "primary_executor_ref": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/executorId" }]
        },
        "collaborator_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/executorId" }
        },
        "estimate": { "$ref": "#/$defs/estimate" },
        "target_window": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/targetWindow" }]
        },
        "rationale_ko": { "type": "string", "minLength": 1 },
        "source_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sourceId" }
        }
      }
    },
    "normalizedAnswer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selected_option_ids", "free_text"],
      "properties": {
        "selected_option_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_-]*$" }
        },
        "free_text": {
          "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }]
        }
      }
    },
    "questionOption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label_ko"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9_-]*$" },
        "label_ko": { "type": "string", "minLength": 1 }
      }
    },
    "activationCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question_ref", "operator", "option_ids"],
      "properties": {
        "question_ref": { "type": "string", "pattern": "^Q-[0-9]{3,}$" },
        "operator": { "const": "selected_option_any_of" },
        "option_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_-]*$" }
        }
      }
    },
    "responseDesign": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basis", "rationale_ko", "source_refs"],
      "properties": {
        "basis": {
          "enum": ["logical_partition", "source_backed_options", "observed_answers", "external_standard", "typed_value", "unbounded_answer_space"]
        },
        "rationale_ko": { "type": "string", "minLength": 1 },
        "source_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sourceId" }
        }
      }
    },
    "questionEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["work_item_refs", "executor_refs", "source_refs"],
      "properties": {
        "work_item_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/workId" }
        },
        "executor_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/executorId" }
        },
        "source_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sourceId" }
        }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "decision_area",
        "origin",
        "depends_on_question_refs",
        "activation_conditions",
        "kind",
        "response_design",
        "question_ko",
        "reason_ko",
        "target_path",
        "blocks_next_step",
        "options",
        "evidence",
        "answer_source_ref",
        "normalized_answer",
        "dismissal_reason_ko"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^Q-[0-9]{3,}$" },
        "status": { "enum": ["pending", "answered", "deferred", "dismissed"] },
        "decision_area": { "enum": ["execution_model", "scope", "estimation", "schedule", "assignment", "approval", "other"] },
        "origin": { "enum": ["initial_plan", "answer_follow_up", "late_discovery", "approval"] },
        "depends_on_question_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^Q-[0-9]{3,}$" }
        },
        "activation_conditions": {
          "type": "array",
          "items": { "$ref": "#/$defs/activationCondition" }
        },
        "kind": { "enum": ["yes_no", "single_choice", "multiple_choice", "short_text", "open_text"] },
        "response_design": { "$ref": "#/$defs/responseDesign" },
        "question_ko": { "type": "string", "minLength": 1 },
        "reason_ko": { "type": "string", "minLength": 1 },
        "target_path": { "type": "string", "pattern": "^/.+" },
        "blocks_next_step": { "type": "boolean" },
        "options": {
          "type": "array",
          "items": { "$ref": "#/$defs/questionOption" }
        },
        "evidence": { "$ref": "#/$defs/questionEvidence" },
        "answer_source_ref": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sourceId" }]
        },
        "normalized_answer": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/normalizedAnswer" }]
        },
        "dismissal_reason_ko": {
          "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }]
        }
      }
    }
  }
}
