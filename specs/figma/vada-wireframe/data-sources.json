{
  "schemaVersion": 1,
  "sources": [
    {
      "key": "home.briefing",
      "shape": "object",
      "description": "홈 브리핑의 인사 제목. 사용자 이름이 들어가므로 서버가 완성해서 준다.",
      "params": [],
      "request": {
        "method": "GET",
        "path": "/api/home/briefing"
      },
      "messages": {
        "loading": "브리핑을 불러오는 중입니다",
        "empty": "확인할 내용이 없습니다",
        "error": "브리핑을 불러오지 못했습니다"
      },
      "fields": [
        {
          "key": "title",
          "description": "인사 제목. 예: 박해랑님, 확인이 필요해요"
        }
      ]
    },
    {
      "key": "home.briefingNotices",
      "shape": "list",
      "description": "브리핑이 짚어 주는 문장들. 짚을 것이 없으면 빈 목록이므로 개수가 데이터에 달렸다.",
      "params": [],
      "request": {
        "method": "GET",
        "path": "/api/home/briefing/notices"
      },
      "messages": {
        "loading": "확인할 내용을 살펴보는 중입니다",
        "empty": "지금은 확인할 내용이 없습니다",
        "error": "확인할 내용을 불러오지 못했습니다"
      },
      "fields": [
        {
          "key": "message",
          "description": "완성된 문장. 예: 지연된 업무가 1건 있습니다."
        }
      ]
    },
    {
      "key": "home.eventCounts",
      "shape": "object",
      "description": "홈 상단에 나열하는 행사·일정 건수.",
      "params": [],
      "request": {
        "method": "GET",
        "path": "/api/home/event-counts"
      },
      "messages": {
        "loading": "건수를 불러오는 중입니다",
        "empty": "표시할 건수가 없습니다",
        "error": "건수를 불러오지 못했습니다"
      },
      "fields": [
        {
          "key": "activeEvents",
          "description": "진행 중 행사 수"
        },
        {
          "key": "upcomingEvents",
          "description": "예정 행사 수"
        },
        {
          "key": "weeklySchedules",
          "description": "이번 주 주요 일정 수"
        }
      ]
    },
    {
      "key": "home.events",
      "shape": "list",
      "description": "진행 중이거나 예정된 행사.",
      "params": [],
      "request": {
        "method": "GET",
        "path": "/api/home/events"
      },
      "messages": {
        "loading": "행사를 불러오는 중입니다",
        "empty": "진행 중이거나 예정된 행사가 없습니다",
        "error": "행사를 불러오지 못했습니다"
      },
      "fields": [
        {
          "key": "status",
          "description": "진행 상태. 예: 기획 중"
        },
        {
          "key": "title",
          "description": "행사 이름"
        },
        {
          "key": "date",
          "description": "행사 날짜. 정해지지 않았으면 '미정'"
        },
        {
          "key": "place",
          "description": "장소. 정해지지 않았으면 '미정'"
        },
        {
          "key": "team",
          "description": "주관 부서"
        },
        {
          "key": "progressPercent",
          "description": "준비 진행률(0-100)"
        },
        {
          "key": "delayedTaskCount",
          "description": "지연된 업무 수. 없으면 오지 않는다.",
          "optional": true
        }
      ]
    },
    {
      "key": "home.schedules",
      "shape": "list",
      "description": "다가오는 주요 일정.",
      "params": [],
      "request": {
        "method": "GET",
        "path": "/api/home/schedules"
      },
      "messages": {
        "loading": "일정을 불러오는 중입니다",
        "empty": "다가오는 일정이 없습니다",
        "error": "일정을 불러오지 못했습니다"
      },
      "fields": [
        {
          "key": "date",
          "description": "월.일. 예: 07.20"
        },
        {
          "key": "title",
          "description": "일정 이름"
        },
        {
          "key": "badge",
          "description": "일정의 성격. 예: 마감"
        }
      ]
    },
    {
      "key": "home.orgAlerts",
      "shape": "list",
      "description": "조직 운영에서 확인이 필요한 항목. 종류가 상황에 따라 달라지므로 개수가 데이터에 달렸다.",
      "params": [],
      "request": {
        "method": "GET",
        "path": "/api/home/org-alerts"
      },
      "messages": {
        "loading": "알림을 불러오는 중입니다",
        "empty": "확인이 필요한 알림이 없습니다",
        "error": "알림을 불러오지 못했습니다"
      },
      "fields": [
        {
          "key": "kind",
          "description": "알림의 종류. 화면은 종류마다 다른 아이콘을 그린다(디자인에 문서형·인원형 둘이 있다)."
        },
        {
          "key": "label",
          "description": "알림 이름. 예: 증빙 서류 누락"
        },
        {
          "key": "count",
          "description": "해당 건수"
        }
      ]
    },
    {
      "key": "home.financeSummary",
      "shape": "object",
      "description": "조직 전체의 재정 현황 요약.",
      "params": [],
      "request": {
        "method": "GET",
        "path": "/api/home/finance-summary"
      },
      "messages": {
        "loading": "재정 현황을 불러오는 중입니다",
        "empty": "재정 현황이 없습니다",
        "error": "재정 현황을 불러오지 못했습니다"
      },
      "fields": [
        {
          "key": "budgetUsedPercent",
          "description": "전체 예산 사용률(0-100)"
        },
        {
          "key": "availableBudgetPercent",
          "description": "사용 가능 예산 비율(0-100)"
        },
        {
          "key": "plannedCount",
          "description": "승인·집행 예정 건수"
        },
        {
          "key": "missingProofCount",
          "description": "증빙 누락 건수"
        }
      ]
    },
    {
      "key": "shell.organization",
      "shape": "object",
      "description": "사이드바에 표시하는 조직 이름. 보는 사람의 소속에 따라 달라진다.",
      "params": [],
      "request": {
        "method": "GET",
        "path": "/api/shell/organization"
      },
      "messages": {
        "loading": "조직을 불러오는 중입니다",
        "empty": "소속된 조직이 없습니다",
        "error": "조직을 불러오지 못했습니다"
      },
      "fields": [
        {
          "key": "name",
          "description": "조직 이름. 예: 소프트웨어융합대학"
        }
      ]
    },
    {
      "key": "shell.viewer",
      "shape": "object",
      "description": "사이드바 아래에 표시하는 보는 사람의 이름과 소속·직책.",
      "params": [],
      "request": {
        "method": "GET",
        "path": "/api/shell/viewer"
      },
      "messages": {
        "loading": "사용자를 불러오는 중입니다",
        "empty": "사용자 정보가 없습니다",
        "error": "사용자 정보를 불러오지 못했습니다"
      },
      "fields": [
        {
          "key": "name",
          "description": "이름. 예: 박해랑"
        },
        {
          "key": "role",
          "description": "소속과 직책. 예: 운영부 · 부원"
        }
      ]
    },
    {
      "key": "my.taskAlerts",
      "shape": "object",
      "description": "내 업무 화면 상단에 나열하는 상태별 건수. 항목이 명세에 고정이라 summary가 읽는다.",
      "params": [],
      "request": {
        "method": "GET",
        "path": "/api/my/task-alerts"
      },
      "messages": {
        "loading": "건수를 불러오는 중입니다",
        "empty": "표시할 건수가 없습니다",
        "error": "건수를 불러오지 못했습니다"
      },
      "fields": [
        {
          "key": "delayedCount",
          "description": "지연된 업무 수"
        },
        {
          "key": "todoCount",
          "description": "해야 할 업무 수"
        },
        {
          "key": "reviewCount",
          "description": "검토가 필요한 업무 수"
        }
      ]
    },
    {
      "key": "my.taskTabCounts",
      "shape": "object",
      "description": "업무 탭마다 곁들이는 건수. fields의 key가 탭 선택지의 value와 같다 — 선택지는 명세가, 건수는 데이터가 정한다.",
      "params": [],
      "request": {
        "method": "GET",
        "path": "/api/my/task-tab-counts"
      },
      "messages": {
        "loading": "건수를 불러오는 중입니다",
        "empty": "표시할 건수가 없습니다",
        "error": "건수를 불러오지 못했습니다"
      },
      "fields": [
        {
          "key": "todo",
          "description": "해야 할 업무 수"
        },
        {
          "key": "inProgress",
          "description": "진행 중인 업무 수"
        },
        {
          "key": "done",
          "description": "완료된 업무 수"
        }
      ]
    },
    {
      "key": "my.tasks",
      "shape": "list",
      "description": "내가 처리할 업무. 고른 탭과 검색어로 걸러서 서버가 준다 — 받아온 것을 화면에서 거르지 않는다.",
      "params": [
        "tab",
        "query"
      ],
      "request": {
        "method": "GET",
        "path": "/api/my/tasks"
      },
      "messages": {
        "loading": "업무를 불러오는 중입니다",
        "empty": "해당하는 업무가 없습니다",
        "error": "업무를 불러오지 못했습니다"
      },
      "fields": [
        {
          "key": "title",
          "description": "업무 이름. 예: 행사 안전 안내문 검토"
        },
        {
          "key": "department",
          "description": "담당 부서. 예: 기획부"
        },
        {
          "key": "status",
          "description": "업무 상태. 예: 검토 필요"
        },
        {
          "key": "nextAction",
          "description": "다음에 할 일. 예: 검토 의견을 확인하고 처리 내용을 기록"
        },
        {
          "key": "context",
          "description": "업무가 속한 맥락. 행사 이름이거나 상시 업무 표시. 예: 2026 소프트웨어융합대학 체육대회"
        },
        {
          "key": "date",
          "description": "기한. 월.일. 예: 07.22"
        },
        {
          "key": "linkedDocument",
          "description": "연결된 문서 이름. 없으면 오지 않는다.",
          "optional": true
        }
      ]
    },
    {
      "key": "ops.intro",
      "shape": "object",
      "description": "운영 허브의 안내 문장. 보는 사람의 이름이 들어가므로 서버가 완성해서 준다(home.briefing과 같은 이유).",
      "params": [],
      "request": {
        "method": "GET",
        "path": "/api/ops/intro"
      },
      "messages": {
        "loading": "운영 공간을 불러오는 중입니다",
        "empty": "안내할 내용이 없습니다",
        "error": "운영 공간을 불러오지 못했습니다"
      },
      "fields": [
        {
          "key": "description",
          "description": "완성된 안내 문장. 예: 박해랑님이 확인할 업무·회의·행사·일정을 선택하세요. …"
        }
      ]
    },
    {
      "key": "ops.spaceStats",
      "shape": "object",
      "description": "운영 공간 4개가 각각 곁들이는 건수. 공간 자체는 제품이 정한 고정 구조라 명세가 갖고, 건수만 서버가 준다.",
      "params": [],
      "request": {
        "method": "GET",
        "path": "/api/ops/space-stats"
      },
      "messages": {
        "loading": "건수를 불러오는 중입니다",
        "empty": "표시할 건수가 없습니다",
        "error": "건수를 불러오지 못했습니다"
      },
      "fields": [
        {
          "key": "taskInProgress",
          "description": "상시 업무 중 진행 중인 수"
        },
        {
          "key": "taskReview",
          "description": "상시 업무 중 검토가 필요한 수"
        },
        {
          "key": "meetingToday",
          "description": "오늘 예정된 회의 수"
        },
        {
          "key": "meetingCleanup",
          "description": "정리가 필요한 회의 수"
        },
        {
          "key": "eventInProgress",
          "description": "진행 중인 행사 수"
        },
        {
          "key": "eventPlanning",
          "description": "기획 중인 행사 수"
        },
        {
          "key": "calendarThisWeek",
          "description": "이번 주 마감 수"
        },
        {
          "key": "calendarUpcoming",
          "description": "다가오는 마감 수"
        }
      ]
    }
  ]
}
