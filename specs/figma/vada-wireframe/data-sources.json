    {
      "key": "my.tasks",
      "shape": "list",
      "description": "내가 처리할 업무. 고른 탭과 검색어로 걸러서 서버가 준다 — 받아온 것을 화면에서 거르지 않는다.",
      "params": [
        "tab",
        "query"
      ],
      "request": {
        "method": "GET",
        "path": "/api/my/tasks"
      },
      "messages": {
        "loading": "업무를 불러오는 중입니다",
        "empty": "해당하는 업무가 없습니다",
        "error": "업무를 불러오지 못했습니다"
      },
      "fields": [
        {
          "key": "title",
          "description": "업무 이름. 예: 행사 안전 안내문 검토"
        },
        {
          "key": "department",
          "description": "담당 부서. 예: 기획부"
        },
        {
          "key": "status",
          "description": "업무 상태. 예: 검토 필요"
        },
        {
          "key": "nextAction",
          "description": "다음에 할 일. 예: 검토 의견을 확인하고 처리 내용을 기록"
        },
        {
          "key": "context",
          "description": "업무가 속한 맥락. 행사 이름이거나 상시 업무 표시. 예: 2026 소프트웨어융합대학 체육대회"
        },
        {
          "key": "date",
          "description": "기한. 월.일. 예: 07.22"
        },
        {
          "key": "linkedDocument",
          "description": "연결된 문서 이름. 없으면 오지 않는다.",
          "optional": true
        }
      ]
    },
    {
      "key": "ops.intro",
      "shape": "object",
      "description": "운영 허브의 안내 문장. 보는 사람의 이름이 들어가므로 서버가 완성해서 준다(home.briefing과 같은 이유).",
      "params": [],
      "request": {
        "method": "GET",
        "path": "/api/ops/intro"
      },
      "messages": {
        "loading": "운영 공간을 불러오는 중입니다",
        "empty": "안내할 내용이 없습니다",
        "error": "운영 공간을 불러오지 못했습니다"
      },
      "fields": [
        {
          "key": "description",
          "description": "완성된 안내 문장. 예: 박해랑님이 확인할 업무·회의·행사·일정을 선택하세요. …"
        }
      ]
    },
    {
      "key": "ops.spaceStats",
      "shape": "object",
      "description": "운영 공간 4개가 각각 곁들이는 건수. 공간 자체는 제품이 정한 고정 구조라 명세가 갖고, 건수만 서버가 준다.",
      "params": [],
      "request": {
        "method": "GET",
