{
  "schemaVersion": 1,
  "mutations": [
    {
      "key": "org.create",
      "description": "학생회와 초기 조직 구조를 생성한다",
      "request": {
        "method": "POST",
        "path": "/api/orgs"
      },
      "payloadScope": "orgCreationDraft",
      "messages": {
        "submitting": "학생회를 만드는 중입니다",
        "error": "학생회를 만들지 못했습니다"
      }
    },
    {
      "key": "finance.purchaseRequest.submit",
      "description": "구매 요청을 재정부 검토로 넘긴다",
      "request": {
        "method": "POST",
        "path": "/api/ops/finance/purchase-requests"
      },
      "payloadScope": "purchaseRequestDraft",
      "messages": {
        "submitting": "구매 요청을 제출하는 중입니다",
        "error": "구매 요청을 제출하지 못했습니다"
      }
    },
    {
      "key": "finance.purchaseRequest.saveDraft",
      "description": "구매 요청을 아직 넘기지 않고 적어 둔 채로 보관한다",
      "request": {
        "method": "POST",
        "path": "/api/ops/finance/purchase-request-drafts"
      },
      "payloadScope": "purchaseRequestDraft",
      "messages": {
        "submitting": "임시 저장하는 중입니다",
        "error": "임시 저장하지 못했습니다"
      }
    },
    {
      "key": "finance.purchaseRequest.resubmitSupplement",
      "description": "보완 요청에 답해 수정한 내용을 재정부에 다시 넘긴다",
      "request": {
        "method": "POST",
        "path": "/api/ops/finance/purchase-requests/supplement/resubmit"
      },
      "payloadScope": "purchaseRequestSupplement",
      "messages": {
        "submitting": "재제출하는 중입니다",
        "error": "재제출하지 못했습니다"
      }
    },
    {
      "key": "finance.purchaseRequest.saveSupplement",
      "description": "보완 답변을 아직 넘기지 않고 적어 둔 채로 보관한다",
      "request": {
        "method": "POST",
        "path": "/api/ops/finance/purchase-requests/supplement/drafts"
      },
      "payloadScope": "purchaseRequestSupplement",
      "messages": {
        "submitting": "임시 저장하는 중입니다",
        "error": "임시 저장하지 못했습니다"
      }
    },
    {
      "key": "finance.purchaseRequest.sendReview",
      "description": "품목마다의 판정과 승인액을 요청자에게 보낸다. 보완이 하나라도 있으면 나가는 것이 보완 요청이고 전부 승인이면 검토가 끝난 것인데, 보내는 일은 하나다",
      "request": {
        "method": "POST",
        "path": "/api/ops/finance/purchase-requests/review"
      },
      "payloadScope": "purchaseRequestReview",
      "messages": {
        "submitting": "검토 결과를 보내는 중입니다",
        "error": "검토 결과를 보내지 못했습니다"
      }
    }
  ]
}
