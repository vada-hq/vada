      },
      "payloadScope": "orgEditDraft",
      "repeat": {
        "kind": "overwrite",
        "why": "조직도 전부를 보낸다. 덮어쓴다."
      },
      "messages": {
        "submitting": "저장하는 중입니다",
        "error": "조직도를 저장하지 못했습니다"
      }
    },
    {
      "key": "org.regenerateInviteLink",
      "description": "공용 초대 링크를 다시 만든다. 전에 나눠 준 링크는 그때부터 듣지 않는다.",
      "authorize": {
        "area": "org.invite"
      },
      "params": [],
      "request": {
        "method": "POST",
        "path": "/api/org/invite/link"
      },
      "repeat": {
        "kind": "idempotencyKey",
        "why": "위와 같다. 두 번 누르면 방금 나눠 준 링크가 죽는다."
      },
      "irreversible": {
        "why": "전에 나눠 준 링크가 그 순간 죽는다."
      },
      "messages": {
        "submitting": "링크를 다시 만드는 중입니다",
        "error": "링크를 다시 만들지 못했습니다"
      }
    },
    {
      "key": "org.regenerateInviteCode",
      "description": "짧은 초대 코드를 다시 만든다.",
      "authorize": {
        "area": "org.invite"
      },
      "params": [],
      "request": {
        "method": "POST",
        "path": "/api/org/invite/code"
      },
      "repeat": {
        "kind": "idempotencyKey",
        "why": "위와 같다. 두 번 누르면 방금 나눠 준 코드가 죽는다."
      },
      "irreversible": {
        "why": "전에 나눠 준 코드가 그 순간 죽는다."
      },
      "messages": {
        "submitting": "코드를 다시 만드는 중입니다",
        "error": "코드를 다시 만들지 못했습니다"
      }
    },
    {
      "key": "org.regenerateInvite",
      "description": "링크와 코드를 함께 다시 만든다. 전에 나눠 준 것이 전부 듣지 않게 된다.",
      "authorize": {
        "area": "org.invite"
      },
      "params": [],
      "request": {
        "method": "POST",
        "path": "/api/org/invite"
      },
      "repeat": {
        "kind": "idempotencyKey",
        "why": "두 번 누르면 **두 번 바뀐다.** 방금 복사한 것이 두 번째 누름에 죽는다 — 덮어쓰기가 아니라 매번 다른 결과다."
      },
      "irreversible": {
        "why": "전에 나눠 준 링크와 코드가 **그 순간 전부 죽는다.** 이미 받은 사람이 못 들어온다."
      },
      "messages": {
        "submitting": "초대 정보를 다시 만드는 중입니다",
        "error": "초대 정보를 다시 만들지 못했습니다"
      }
    },
    {
      "key": "org.changeRole",
      "description": "고른 구성원의 기본 역할을 바꾼다. 회의·행사별 맥락 역할은 이 화면이 건드리지 않는다.\n\n**누구의 역할인지가 계약에 없었다.** 자리도 인자도 없어서 서버가 알 길이 없었고, 화면도 고른 사람을 넘길 어휘가 없어 서버가 '마지막으로 고른 사람'을 기억해 대신하고 있었다 — 두 사람이 같은 화면을 열면 서로의 고른 것을 본다. 자리에 사람을 박아 그 자리를 없앤다.",
      "authorize": {
        "area": "org.structure"
      },
      "params": [
        {
          "key": "memberId",
          "required": true,
          "valueType": "string",
          "description": "누구의 역할을 바꾸는가"
        }
      ],
      "request": {
        "method": "PUT",
        "path": "/api/org/members/{memberId}/role"
      },
      "payloadScope": "roleChangeDraft",
      "repeat": {
        "kind": "overwrite",
        "why": "그 사람의 역할을 정한다. 두 번 정해도 같은 역할이다."
      },
      "messages": {
        "submitting": "역할을 바꾸는 중입니다",
        "error": "역할을 바꾸지 못했습니다"
      }
    },
    {
      "key": "meeting.create",
      "description": "회의를 만든다. 유형·기본 정보·일정·참가자와 권한·안건을 한 번에 보낸다",
      "authorize": {
        "area": "meeting.create"
      },
      "params": [],
      "request": {
        "method": "POST",
        "path": "/api/ops/meetings"
      },
      "payloadScope": "meetingDraft",
      "repeat": {
        "kind": "idempotencyKey",
        "why": "같은 제목의 회의를 둘 만드는 것이 정당할 수 있다."
      },
      "messages": {
        "submitting": "회의를 만드는 중입니다",
        "error": "회의를 만들지 못했습니다"
      }
    },
    {
      "key": "meeting.saveDraft",
      "description": "회의를 임시 저장한다. 제출과 **같은 것**을 보내되 보내는 곳이 다르다. 임시 저장한 회의는 다른 참가자에게 표시되지 않는다",
      "authorize": {
        "area": "meeting.create"
      },
      "params": [],
      "request": {
        "method": "POST",
        "path": "/api/ops/meetings/drafts"
      },
      "payloadScope": "meetingDraft",
      "repeat": {
        "kind": "overwrite",
        "why": "임시 저장은 덮어쓰기다. 초안은 회의마다 하나뿐이다."
      },
      "messages": {
        "submitting": "임시 저장하는 중입니다",
        "error": "임시 저장하지 못했습니다"
      }
    },
    {
      "key": "meeting.start",
      "description": "회의를 시작한다. 상태가 '진행 중'으로 바뀌고 참가자에게 '회의 참가'가 열린다(D01). 보낼 초안이 없다 — 무엇의 것인지는 화면이 받은 인자가 안다",
      "authorize": {
        "area": "meeting.run",
        "object": "meetingId"
      },
      "params": [
        {
          "key": "meetingId",
          "required": true,
          "valueType": "string",
          "description": "어느 회의인가"
        }
      ],
      "request": {
        "method": "POST",
        "path": "/api/ops/meetings/{meetingId}/start"
      },
      "repeat": {
        "kind": "conflict",
        "why": "이미 진행 중인 회의를 또 시작할 수 없다. 조용히 넘어가면 '남이 먼저 시작했다'를 아무도 모른다."
      },
      "messages": {
        "submitting": "회의를 시작하는 중입니다",
        "error": "회의를 시작하지 못했습니다"
      }
    },
    {
      "key": "meeting.end",
      "description": "회의를 끝낸다. **상태는 '완료'가 아니라 '정리 중'이 된다**(D02). 회의록과 결정을 확인한 뒤에 따로 정리 완료한다",
      "authorize": {
        "area": "meeting.run",
        "object": "meetingId"
      },
      "params": [
        {
          "key": "meetingId",
          "required": true,
          "valueType": "string",
          "description": "어느 회의인가"
        }
      ],
      "request": {
        "method": "POST",
        "path": "/api/ops/meetings/{meetingId}/end"
      },
      "repeat": {
        "kind": "conflict",
        "why": "이미 끝난 회의를 또 끝낼 수 없다."
      },
      "messages": {
        "submitting": "회의를 종료하는 중입니다",
        "error": "회의를 종료하지 못했습니다"
      }
    },
    {
      "key": "meeting.cancel",
      "description": "회의를 취소한다(D04). 회의는 지워지지 않고 취소된 기록으로 남는다. 취소 사유가 필수다",
      "authorize": {
        "area": "meeting.own",
        "object": "meetingId"
      },
      "params": [
        {
          "key": "meetingId",
          "required": true,
          "valueType": "string",
          "description": "어느 회의인가"
        }
      ],
      "request": {
        "method": "POST",
        "path": "/api/ops/meetings/{meetingId}/cancel"
      },
      "payloadScope": "meetingCancelDraft",
      "repeat": {
        "kind": "conflict",
        "why": "이미 취소된 회의를 또 취소할 수 없다."
      },
      "messages": {
        "submitting": "회의를 취소하는 중입니다",
        "error": "회의를 취소하지 못했습니다"
      }
    },
    {
      "key": "meeting.grantHostRole",
      "description": "한 사람에게 이 회의의 진행 권한을 준다(D03). 옮기는 것이 아니라 더하는 것이다. **누구에게 주는지가 계약에 없었다** — 빼는 쪽(DELETE)은 자리에 사람이 박혀 있는데 주는 쪽은 없어서, 서버가 누구인지 알 길이 없었다. 두 쪽을 같은 자리로 맞췄다.",
      "authorize": {
        "area": "meeting.own",
        "object": "meetingId"
      },
      "params": [
        {
          "key": "meetingId",
          "required": true,
          "valueType": "string",
          "description": "어느 회의인가"
        },
        {
          "key": "memberId",
          "required": true,
          "valueType": "string",
          "description": "누구에게 주는가"
        }
      ],
      "request": {
        "method": "POST",
        "path": "/api/ops/meetings/{meetingId}/hosts/{memberId}"
      },
      "repeat": {
        "kind": "naturalKey",
        "naturalKey": [
          "meetingId",
          "memberId"
        ],
        "why": "'옮기는 것이 아니라 더하는 것'이므로 이미 가진 사람에게 또 줘도 가진 채다."
      },
      "messages": {
        "submitting": "진행 권한을 부여하는 중입니다",
        "error": "진행 권한을 부여하지 못했습니다"
      }
    },
    {
      "key": "meeting.revokeHostRole",
      "description": "한 사람의 진행 권한을 뺀다. **확인 모달이 그려지지 않았다** — 부여(D03)에만 있다. 뺏는 쪽이 더 위험한데 그림에 없다",
      "authorize": {
        "area": "meeting.own",
        "object": "meetingId"
      },
      "params": [
        {
          "key": "meetingId",
          "required": true,
          "valueType": "string",
          "description": "어느 회의인가"
        },
        {
          "key": "memberId",
          "required": true,
          "valueType": "string",
          "description": "어느 구성원인가"
        }
      ],
      "request": {
        "method": "DELETE",
        "path": "/api/ops/meetings/{meetingId}/hosts/{memberId}"
      },
      "repeat": {
        "kind": "overwrite",
        "why": "뺀다. 이미 없는 사람에게서 또 빼도 없는 채로다."
      },
      "irreversible": {
        "why": "뺏긴 사람은 스스로 되돌릴 수 없다. 주는 쪽(D03)에만 확인이 그려지고 빼는 쪽에는 없었다 — 뺏는 쪽이 더 위험한데 그림에 없다고 카탈로그가 짚었다."
      },
      "messages": {
        "submitting": "진행 권한을 해제하는 중입니다",
        "error": "진행 권한을 해제하지 못했습니다"
      }
    },
    {
      "key": "meeting.completeAgenda",
      "description": "지금 진행 중인 안건의 논의를 마친다. **어느 안건인지를 인자로 받지 않는다** — 단추의 뜻이 '이 안건'이고 그것은 지금 진행 중인 것이며, 어느 것이 진행 중인지는 서버가 안다. 화면에는 안건 id를 넘길 길이 없었다(단추는 데이터를 읽지 않는다). 다음 안건으로 넘기는 자리도 같은 모양이다(/agendas/next).",
      "authorize": {
        "area": "meeting.run",
        "object": "meetingId"
      },
      "params": [
        {
          "key": "meetingId",
          "required": true,
          "valueType": "string",
          "description": "어느 회의인가"
        }
      ],
      "request": {
        "method": "POST",
        "path": "/api/ops/meetings/{meetingId}/agendas/current/complete"
      },
      "repeat": {
        "kind": "conflict",
        "why": "진행 중인 안건이 없으면 마칠 것이 없다. **진행 권한자가 여럿일 수 있으므로**(명세가 '최소 1명 유지'와 '현재 진행 권한자 2명'을 말한다) 남이 먼저 넘긴 뒤 눌리면 이미 다음 안건이 진행 중이다 — 그 경우 이 자리는 남이 넘긴 것을 막지 못한다. 안건 id를 받으면 막을 수 있지만 화면이 그것을 넘길 길이 없다."
      },
      "messages": {
        "submitting": "안건을 마치는 중입니다",
        "error": "안건을 마치지 못했습니다"
      }
    },
    {
      "key": "meeting.startNextAgenda",
      "description": "다음 안건을 진행 중으로 넘긴다",
      "authorize": {
        "area": "meeting.run",
        "object": "meetingId"
      },
      "params": [
        {
          "key": "meetingId",
          "required": true,
          "valueType": "string",
          "description": "어느 회의인가"
        }
      ],
