{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./.env.local)",
      "Read(./**/.env.local)",
      "Read(./.env.*.local)",
      "Read(./**/.env.*.local)",
      "Read(./secrets/**)",
      "Read(./**/secrets/**)",
      "Read(./config/credentials.json)",
      "Read(./**/config/credentials.json)",
      "Edit(./.env)",
      "Edit(./**/.env)",
      "Edit(./.env.local)",
      "Edit(./**/.env.local)",
      "Edit(./.env.*.local)",
      "Edit(./**/.env.*.local)",
      "Edit(./secrets/**)",
      "Edit(./**/secrets/**)",
      "Edit(./config/credentials.json)",
      "Edit(./**/config/credentials.json)"
    ]
  }
}
