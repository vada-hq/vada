{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "button.schema.json",
  "title": "Button element",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "label",
    "initiallyDisabled",
    "action"
  ],
  "properties": {
    "type": {
      "const": "button"
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "description": "버튼 아래에 표시할 보조 설명(선택). 카드형 버튼의 부연 문구."
    },
    "badge": {
      "type": "string",
      "minLength": 1,
      "description": "라벨 옆에 표시할 짧은 배지 문구(선택). 예: 초대 코드 입력"
    },
    "initiallyDisabled": {
      "type": "boolean"
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "dependentRequired": {
        "executeWhen": ["onExecutionBlocked"],
        "onExecutionBlocked": ["executeWhen"]
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "navigate" } } },
          "then": { "required": ["targetScreenId"] }
        },
        {
          "if": { "properties": { "type": { "const": "submit" } } },
          "then": { "required": ["mutationKey", "onSuccess"] }
        }
      ],
      "properties": {
        "type": {
          "enum": [
            "navigate",
            "submit"
          ]
        },
        "targetScreenId": {
          "type": "string",
          "minLength": 1,
          "description": "navigate 전용. 이동할 화면."
        },
        "mutationKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "description": "submit 전용. mutations.json 카탈로그의 key. 경로·payload 스코프·상태 문구는 카탈로그가 갖는다."
        },
        "onSuccess": {
          "type": "object",
          "additionalProperties": false,
          "description": "submit 전용. 전송이 성공했을 때의 처리. 수명 관리(스코프 제거)와 데이터 전송은 분리된 관심사이므로, 스코프 이벤트는 여기서만 발생한다.",
          "properties": {
            "navigate": {
              "type": "string",
              "minLength": 1
            },
            "scopeEvent": {
              "enum": [
                "complete",
                "cancel"
              ]
            }
          }
        },
        "executeWhen": {
          "description": "생략하면 버튼은 조건 없이 항상 실행됩니다(예: 필수 입력이 없는 화면의 버튼, 뒤로 가기). 명시하면 onExecutionBlocked도 함께 명시해야 합니다.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "scope"
          ],
          "properties": {
            "type": {
              "const": "allRequiredFieldsHaveValue"
            },
            "scope": {
              "const": "screen"
            }
          }
        },
        "onExecutionBlocked": {
          "description": "executeWhen이 있을 때만 함께 사용합니다. 실행이 차단됐을 때의 동작입니다.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "focus"
          ],
          "properties": {
            "type": {
              "const": "showMissingRequiredFields"
            },
            "focus": {
              "const": "firstMissingField"
            }
          }
        }
      }
    }
  }
}
