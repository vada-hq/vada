{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "button.schema.json",
  "title": "Button element",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "label",
    "initiallyDisabled",
    "action"
  ],
  "properties": {
    "type": {
      "const": "button"
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "labelHidden": {
      "type": "boolean",
      "description": "라벨이 그려지지 않고 그림만 있는가(기본 false). 지금까지 조작에는 늘 글이 있었고, 그래서 label은 '그려지는 글'이면서 동시에 '부르는 이름'이었다. 뒤로 가기 화살표처럼 글 없는 조작이 나오면 둘이 갈린다 — 그려지는 것은 그림뿐이지만 읽어 주는 이름은 있어야 한다. meta.title과 titleFrom이 이미 같은 것을 갈랐다: 그려지는 것이 데이터일 때 title은 이름으로만 남는다.\\n\\n이때 label은 디자인에 없는 글이므로 명세가 정한다. **지어내지 않으려면 적힌 것이 있어야 한다** — 적을 자리가 없으면 구현이 지어내고, 그것은 아무도 못 본다(params[].missingNote와 같은 이유다). 대조기는 이 글을 찾지 않고, 구현은 이것을 접근 이름으로 쓴다."
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "description": "버튼 아래에 표시할 보조 설명(선택). 카드형 버튼의 부연 문구."
    },
    "badge": {
      "type": "string",
      "minLength": 1,
      "description": "라벨 옆에 표시할 짧은 배지 문구(선택). 예: 초대 코드 입력"
    },
    "emphasis": {
      "type": "string",
      "enum": [
        "primary",
        "secondary",
        "quiet"
      ],
      "description": "화면 안에서의 상대적 강조도(선택). 시각 형태가 아니라 역할이다 — 구현이 형태로 옮긴다. 나란한 버튼이 둘 이상일 때만 의미가 있고, 디자인의 채움 > 테두리 > 없음 순서로 유도한다."
    },
    "initiallyDisabled": {
      "type": "boolean"
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "dependentRequired": {
        "executeWhen": [
          "onExecutionBlocked"
        ],
        "onExecutionBlocked": [
          "executeWhen"
        ]
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "navigate"
              }
            }
          },
          "then": {
            "required": [
              "targetScreenId"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "submit"
              }
            }
          },
          "then": {
            "required": [
              "mutationKey",
              "onSuccess"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "pending"
              }
            }
          },
          "then": {
            "required": [
              "note"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "targetScreenId"
                  ]
                },
                {
                  "required": [
                    "mutationKey"
                  ]
                }
              ]
            }
          }
        }
      ],
      "properties": {
        "type": {
          "enum": [
            "navigate",
            "submit",
            "pending"
          ],
          "description": "pending은 '누르면 무엇이 일어나는지 아직 정해지지 않았다'를 명시한다. 대상 화면이 아직 명세되지 않았을 때 쓴다."
        },
        "targetScreenId": {
          "type": "string",
          "minLength": 1,
          "description": "navigate 전용. 이동할 화면."
        },
        "params": {
          "$ref": "element-params.schema.json#/$defs/argument",
          "description": "navigate 전용. 이동하면서 대상 화면에 넘기는 인자(선택). key는 대상 화면의 params에 선언된 이름이다. 표시 요소의 동작(element-action.schema.json)과 같은 모양이다 — 항목이 없는 자리이므로 itemField는 쓸 수 없다."
        },
        "mutationKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "description": "submit 전용. mutations.json 카탈로그의 key. 경로·payload 스코프·상태 문구는 카탈로그가 갖는다."
        },
        "onSuccess": {
          "type": "object",
          "additionalProperties": false,
          "description": "submit 전용. 전송이 성공했을 때의 처리. 수명 관리(스코프 제거)와 데이터 전송은 분리된 관심사이므로, 스코프 이벤트는 여기서만 발생한다.",
          "properties": {
            "navigate": {
              "type": "string",
              "minLength": 1
            },
            "scopeEvent": {
              "enum": [
                "complete",
                "cancel"
              ]
            }
          }
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "description": "pending 전용. 무엇이 정해지지 않았는지. 대상 화면 id를 지어내면 그건 추측이고, 실제 화면이 등록될 때 전부 틀린 것으로 드러난다."
        },
        "executeWhen": {
          "description": "생략하면 버튼은 조건 없이 항상 실행됩니다(예: 필수 입력이 없는 화면의 버튼, 뒤로 가기). 명시하면 onExecutionBlocked도 함께 명시해야 합니다.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "scope"
          ],
          "properties": {
            "type": {
              "const": "allRequiredFieldsHaveValue"
            },
            "scope": {
              "const": "screen"
            }
          }
        },
        "onExecutionBlocked": {
          "description": "executeWhen이 있을 때만 함께 사용합니다. 실행이 차단됐을 때의 동작입니다.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "focus"
          ],
          "properties": {
            "type": {
              "const": "showMissingRequiredFields"
            },
            "focus": {
              "const": "firstMissingField"
            }
          }
        }
      }
    }
  }
}
