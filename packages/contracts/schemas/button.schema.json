{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "button.schema.json",
  "title": "Button element",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "label",
    "initiallyDisabled",
    "action"
  ],
  "properties": {
    "type": {
      "const": "button"
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "initiallyDisabled": {
      "type": "boolean"
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "targetScreenId"
      ],
      "dependentRequired": {
        "executeWhen": ["onExecutionBlocked"],
        "onExecutionBlocked": ["executeWhen"]
      },
      "properties": {
        "type": {
          "const": "navigate"
        },
        "targetScreenId": {
          "type": "string",
          "minLength": 1
        },
        "executeWhen": {
          "description": "생략하면 버튼은 조건 없이 항상 실행됩니다(예: 필수 입력이 없는 화면의 버튼, 뒤로 가기). 명시하면 onExecutionBlocked도 함께 명시해야 합니다.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "scope"
          ],
          "properties": {
            "type": {
              "const": "allRequiredFieldsHaveValue"
            },
            "scope": {
              "const": "screen"
            }
          }
        },
        "onExecutionBlocked": {
          "description": "executeWhen이 있을 때만 함께 사용합니다. 실행이 차단됐을 때의 동작입니다.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "focus"
          ],
          "properties": {
            "type": {
              "const": "showMissingRequiredFields"
            },
            "focus": {
              "const": "firstMissingField"
            }
          }
        }
      }
    }
  }
}
