{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "option-sources.schema.json",
  "title": "Wireframe option source catalog",
  "description": "Remote responses are normalized to { options: [{ value, label, disabled? }] }.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sources"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "type",
          "description",
          "params"
        ],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "static",
              "remote"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "params": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "options": {
            "$ref": "#/$defs/options"
          },
          "request": {
            "$ref": "#/$defs/request"
          },
          "messages": {
            "$ref": "#/$defs/messages"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "static"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "required": [
                "options"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "request"
                    ]
                  },
                  {
                    "required": [
                      "messages"
                    ]
                  }
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "remote"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "required": [
                "request",
                "messages"
              ],
              "not": {
                "required": [
                  "options"
                ]
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "options": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "value",
          "label"
        ],
        "properties": {
          "value": {
            "type": [
              "string",
              "integer",
              "number",
              "boolean"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "description": "선택지 부연 설명(선택). 라디오 카드처럼 선택지마다 설명이 붙는 표현에서 쓴다."
          },
          "disabled": {
            "type": "boolean"
          },
          "initiallySelected": {
            "type": "boolean",
            "description": "**아무것도 고르지 않았을 때 열려 있는 것**(선택). 목록 안에서 하나만 참일 수 있다.\n\n`select.initialValue`는 명세가 값을 못 박는 자리다 — 뜻이 고정된 갈래에서 쓴다(EVT-05B의 '문항 복사'). 그런데 **처음 열릴 것이 데이터일 때**가 있다.\n\n· MSG-02의 방 분류 — 그림은 '일반'이 골라진 모습인데 목록이 원격이라 명세가 값을 부를 수 없다. '일반'과 행사들이 한 줄에 섞여 있어 목록 자체도 명세가 들 수 없다.\n· OPS-MEET-06B의 안건 고르기 — 정리하러 들어오면 아직 정리되지 않은 안건이 열려 있어야 하는데, 그것이 몇 번째인지는 **그 회의의 정리 상태가 정한다.** 명세가 값을 못 박으면 데이터가 바뀔 때마다 틀리고, 화면이 첫째를 열면 이미 끝난 안건이 열린다.\n\n**판정은 서버가 한다.** 화면이 '아직 안 끝난 첫째'를 골라 열면 그 규칙이 화면에 박히고, 규칙이 바뀔 때마다 화면을 고쳐야 한다."
          }
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "path",
        "loadOn"
      ],
      "properties": {
        "method": {
          "const": "GET"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^/"
        },
        "loadOn": {
          "type": "string",
          "enum": [
            "search",
            "open"
          ]
        },
        "search": {
          "oneOf": [
            {
              "$ref": "#/$defs/remoteSearch"
            },
            {
              "$ref": "#/$defs/clientSearch"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "loadOn": {
                "const": "search"
              }
            },
            "required": [
              "loadOn"
            ]
          },
          "then": {
            "required": [
              "search"
            ],
            "properties": {
              "search": {
                "$ref": "#/$defs/remoteSearch"
              }
            }
          }
        }
      ]
    },
    "remoteSearch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "queryParam",
        "minLength",
        "debounceMs"
      ],
      "properties": {
        "mode": {
          "const": "remote"
        },
        "queryParam": {
          "type": "string",
          "minLength": 1
        },
        "minLength": {
          "type": "integer",
          "minimum": 1
        },
        "debounceMs": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "clientSearch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "const": "client"
        }
      }
    },
    "messages": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "idle",
        "loading",
        "empty",
        "error"
      ],
      "properties": {
        "idle": {
          "type": "string",
          "minLength": 1
        },
        "loading": {
          "type": "string",
          "minLength": 1
        },
        "empty": {
          "type": "string",
          "minLength": 1
        },
        "error": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
