{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "element-action.schema.json",
  "title": "Shared element action",
  "description": "표시 요소가 눌렸을 때의 동작. button.action과 규칙이 같지만 제출(submit)은 갖지 않는다 — 표시 요소는 값을 보내지 않는다. itemList.itemAction과 summary.action이 이것을 참조한다. 세 번째로 같은 모양이 필요해졌을 때 뽑았다.",
  "$defs": {
    "displayAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "navigate",
            "pending"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "description": "동작을 알리는 문구(선택). 예: 업무 보드 열기. 요소 자체의 제목과 다르다."
        },
        "targetScreenId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "description": "아직 명세되지 않은 화면임을 알리는 문구."
        },
        "labelField": {
          "type": "string",
          "minLength": 1,
          "description": "동작의 문구가 데이터에서 오는 경우 그 조각의 key(선택). label과 함께 쓸 수 없다. 목록 항목마다 문구가 다른 경우다 — 회의 목록의 '회의록 보기'·'회의로 돌아가기'는 그 회의의 상태가 정한다."
        },
        "emphasisField": {
          "type": "string",
          "minLength": 1,
          "description": "동작의 강조도가 데이터에서 오는 경우 그 조각의 key(선택). 값은 button.emphasis와 같은 말(primary·secondary·quiet)이다. 항목마다 얼마나 앞세울지가 다른 경우다."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "navigate"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "targetScreenId"
            ],
            "not": {
              "required": [
                "note"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "pending"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "note"
            ],
            "not": {
              "required": [
                "targetScreenId"
              ]
            }
          }
        },
        {
          "not": {
            "required": [
              "label",
              "labelField"
            ]
          }
        }
      ]
    }
  }
}
