{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "element-action.schema.json",
  "title": "Shared element action",
  "description": "표시 요소가 눌렸을 때의 동작. button.action과 규칙이 같지만 제출(submit)은 갖지 않는다 — 표시 요소는 값을 보내지 않는다. itemList.itemAction과 summary.action이 이것을 참조한다. 세 번째로 같은 모양이 필요해졌을 때 뽑았다.",
  "$defs": {
    "displayAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "navigate",
            "pending",
            "choose"
          ],
          "description": "`navigate` 다음 화면으로 간다 · `pending` 아직 무엇을 하는지 그림에 없다 · `choose` **눌린 항목이 이 화면의 값이 된다.**\n\n`choose`가 오래 없었다. 그동안 ORG-04B는 '어느 구성원을 고를지가 아직 주소로 오가지 않는다'며 `pending`으로 두었고, 서버가 **마지막으로 고른 사람**을 기억해 대신했다 — 사람마다 다른 서버 상태이고 두 사람이 같은 화면을 열면 서로의 고른 것을 본다.\n\n이동과 다른 점은 **화면을 떠나지 않는다**는 것이다. 고른 뒤에도 목록이 그대로 있고, 고른 것을 곁의 요소들이 읽는다."
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "description": "동작을 알리는 문구(선택). 예: 업무 보드 열기. 요소 자체의 제목과 다르다."
        },
        "targetScreenId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "targetField": {
          "type": "string",
          "minLength": 1,
          "description": "가는 곳이 항목마다 다를 때, **어느 곳인지를 아는 조각**의 key(선택). targetScreenId와 함께 쓸 수 없다.\n\n데이터가 화면 id를 직접 주지 않는 것이 요점이다 — 그러면 검증기가 그 화면이 있는지 확인할 수 없고, 서버가 없는 화면을 가리켜도 아무도 모른다. 대신 **데이터는 열쇠를 주고 명세가 그 열쇠로 갈 곳을 정한다**(targets). option-sources가 값의 뜻을 명세에 두는 것과 같은 규칙이다."
        },
        "targets": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "description": "열쇠마다 갈 곳. targetField와 함께만 쓴다. 검증기가 여기 적힌 화면이 모두 있는지 본다.\n\n세 자리에서 같은 벽에 부딪혀 만들었다 — 회의 목록의 줄은 그 회의의 상태에 따라 예정 상세·진행 중·완료 회의록으로 갈리고(OPS-MEET-01A), 행사의 '지금 확인해야 할 항목'은 참가자 명단과 업무 보드로 갈리며(EVT-02), 행사 일정의 줄은 그 일정이 어디서 온 것인지에 따라 갈린다(EVT-SCHED-01).",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "value",
              "targetScreenId"
            ],
            "properties": {
              "value": {
                "type": "string",
                "minLength": 1,
                "description": "targetField가 이 값일 때."
              },
              "targetScreenId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
              }
            }
          }
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "description": "아직 명세되지 않은 화면임을 알리는 문구."
        },
        "labelField": {
          "type": "string",
          "minLength": 1,
          "description": "동작의 문구가 데이터에서 오는 경우 그 조각의 key(선택). label과 함께 쓸 수 없다. 목록 항목마다 문구가 다른 경우다 — 회의 목록의 '회의록 보기'·'회의로 돌아가기'는 그 회의의 상태가 정한다."
        },
        "emphasisField": {
          "type": "string",
          "minLength": 1,
          "description": "동작의 강조도가 데이터에서 오는 경우 그 조각의 key(선택). 값은 button.emphasis와 같은 말(primary·secondary·quiet)이다. 항목마다 얼마나 앞세울지가 다른 경우다."
        },
        "params": {
          "$ref": "element-params.schema.json#/$defs/argument",
          "description": "이동하면서 대상 화면에 넘기는 인자(선택). key는 대상 화면의 params에 선언된 이름이다. 화면이 인자를 받는다면 누군가는 그 값을 줘야 하고, 그 자리가 여기다 — 칸반 카드가 '어느 업무의 상세인지'를 넘기는 것이 첫 사례다. 값의 출처는 조회 인자와 같은 넷이며, 목록 항목의 동작에서는 눌린 그 항목의 조각(itemField)을 쓴다."
        },
        "fieldKey": {
          "type": "string",
          "minLength": 1,
          "description": "고른 것이 담기는 화면의 칸. 다른 요소들이 이 칸을 조회 인자로 가리켜 '고른 그것'을 읽는다."
        },
        "itemField": {
          "type": "string",
          "minLength": 1,
          "description": "눌린 항목의 어느 조각을 담는가. 그 목록의 데이터 출처에 선언돼 있어야 한다."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "navigate"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "oneOf": [
              {
                "required": [
                  "targetScreenId"
                ],
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "targetField"
                      ]
                    },
                    {
                      "required": [
                        "targets"
                      ]
                    }
                  ]
                }
              },
              {
                "required": [
                  "targetField",
                  "targets"
                ],
                "not": {
                  "required": [
                    "targetScreenId"
                  ]
                }
              }
            ],
            "not": {
              "required": [
                "note"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "pending"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "note"
            ],
            "not": {
              "required": [
                "targetScreenId"
              ]
            }
          }
        },
        {
          "not": {
            "required": [
              "label",
              "labelField"
            ]
          }
        },
        {
          "dependentRequired": {
            "targetField": [
              "targets"
            ],
            "targets": [
              "targetField"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "choose"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "fieldKey",
              "itemField"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "targetScreenId"
                  ]
                },
                {
                  "required": [
                    "note"
                  ]
                },
                {
                  "required": [
                    "params"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "not": {
                  "const": "choose"
                }
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "fieldKey"
                  ]
                },
                {
                  "required": [
                    "itemField"
                  ]
                }
              ]
            }
          }
        }
      ]
    }
  }
}
