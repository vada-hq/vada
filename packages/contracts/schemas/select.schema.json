{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "select.schema.json",
  "title": "Select element",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "fieldKey",
    "label",
    "placeholder",
    "initialValue",
    "valueType",
    "required",
    "initiallyDisabled",
    "searchable",
    "optionsSource"
  ],
  "properties": {
    "type": {
      "const": "select"
    },
    "fieldKey": {
      "type": "string",
      "minLength": 1
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "placeholder": {
      "type": [
        "string",
        "null"
      ]
    },
    "disabledPlaceholder": {
      "type": "string",
      "minLength": 1,
      "description": "비활성(enabledWhen 미충족) 상태에서 표시할 문구. 생략하면 placeholder를 그대로 쓴다. placeholder는 활성 상태 문구다."
    },
    "helperText": {
      "type": "string",
      "minLength": 1,
      "description": "필드 아래에 항상 표시하는 보조 설명(선택)."
    },
    "presentation": {
      "type": "string",
      "enum": [
        "dropdown",
        "choiceGroup"
      ],
      "description": "선택 UI 형태. dropdown=목록 패널을 열어 고른다. choiceGroup=선택지를 모두 펼친 버튼 묶음에서 고른다. 생략하면 dropdown이다. searchable(목록 필터링 가능 여부)과는 다른 축이다."
    },
    "initialValue": {
      "type": [
        "string",
        "null"
      ]
    },
    "valueType": {
      "type": "string",
      "enum": [
        "string",
        "integer",
        "number",
        "boolean"
      ]
    },
    "required": {
      "type": "boolean"
    },
    "initiallyDisabled": {
      "type": "boolean"
    },
    "searchable": {
      "type": "boolean"
    },
    "optionsSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "params": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "enabledWhen": {
      "description": "생략하면 항상 활성화됩니다. 명시하면 모든 조건을 만족할 때 활성화됩니다.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fieldKey",
          "operator"
        ],
        "properties": {
          "fieldKey": {
            "type": "string",
            "minLength": 1
          },
          "operator": {
            "type": "string",
            "enum": [
              "hasValue"
            ]
          }
        }
      }
    },
    "resetOnChangeOf": {
      "description": "나열한 필드의 값이 변경되거나 지워지면 현재 값을 초기화합니다.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
