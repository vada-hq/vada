{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "screen.schema.json",
  "title": "Screen behavior spec",
  "description": "화면 단위 동작 명세의 겉 구조. elements[].spec 본문은 spec.type에 따라 input/select/button 스키마로 별도 검증한다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "screenId",
    "source",
    "elements"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "screenId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "stateScopeKey": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title"
      ],
      "description": "화면 수준 카피. 구현은 이 값을 렌더하며 JSX에 하드코딩하지 않는다.",
      "properties": {
        "eyebrow": {
          "type": [
            "string",
            "null"
          ],
          "description": "제목 위에 표시하는 소제목(선택). 예: 새 학생회 만들기"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "footerNote": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pageName",
        "nodeId",
        "name",
        "figmaType"
      ],
      "properties": {
        "pageName": {
          "type": "string",
          "minLength": 1
        },
        "nodeId": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        },
        "figmaType": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "elements": {
      "type": "array",
      "description": "화면에 보이는 순서대로 나열한다. 버튼 실행 차단의 firstMissingField(화면 순서상 첫 누락 필드)와 판정 후보 순서는 이 배열 순서를 따른다.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "spec"
        ],
        "properties": {
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "nodeId",
              "name",
              "figmaType"
            ],
            "properties": {
              "nodeId": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string"
              },
              "figmaType": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "spec": {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "enum": [
                  "input",
                  "select",
                  "button",
                  "note",
                  "group",
                  "list",
                  "summary"
                ]
              }
            }
          }
        }
      }
    }
  }
}
