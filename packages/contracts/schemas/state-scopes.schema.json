{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "state-scopes.schema.json",
  "title": "Wireframe state scope catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "scopes"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "scopes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "description",
          "lifetime",
          "clearOn"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "lifetime": {
            "const": "flow"
          },
          "clearOn": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "complete",
                "cancel"
              ]
            }
          }
        }
      }
    }
  }
}
