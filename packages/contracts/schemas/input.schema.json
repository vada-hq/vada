{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "input.schema.json",
  "title": "Input element",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "fieldKey",
    "label",
    "placeholder",
    "initialValue",
    "inputType",
    "valueType",
    "required",
    "validation"
  ],
  "properties": {
    "type": {
      "const": "input"
    },
    "fieldKey": {
      "type": "string",
      "minLength": 1
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "labelHidden": {
      "type": "boolean",
      "description": "라벨이 이 자리에 그려지지 않는가(기본 false). 표의 칸이 그렇다 — 열 머리가 한 번 그려지고 칸마다 다시 그려지지 않는다. 그래도 **읽어 주는 이름은 있어야 하므로** label은 여전히 필수다(button.labelHidden과 같은 규칙이다). 대조기는 이 글을 자리 안에서 찾지 않는다."
    },
    "placeholder": {
      "type": [
        "string",
        "null"
      ]
    },
    "helperText": {
      "type": "string",
      "minLength": 1,
      "description": "필드 아래에 항상 표시하는 보조 설명(선택)."
    },
    "initialValue": {
      "type": [
        "string",
        "null"
      ]
    },
    "inputType": {
      "type": "string",
      "enum": [
        "text",
        "email",
        "password",
        "number",
        "tel",
        "url",
        "search",
        "date",
        "time",
        "datetime-local",
        "file"
      ],
      "description": "칸이 받는 값의 종류. HTML input의 type과 같은 말이며 **role까지 정한다** - search는 textbox가 아니라 searchbox다.\n\nfile은 값이 글이 아니라 고른 파일이다. 그래도 화면에 그려지는 것은 그 파일의 이름이라 valueType은 string이다 - 명세가 아는 것은 '무엇을 고르게 하는가'까지다."
    },
    "valueType": {
      "type": "string",
      "enum": [
        "string",
        "integer",
        "number",
        "boolean"
      ]
    },
    "required": {
      "type": "boolean"
    },
    "readOnly": {
      "type": "boolean",
      "description": "값을 보여주되 사람이 고칠 수 없는 칸(기본 false). 비활성(initiallyDisabled)과 다르다 — 저것은 아직 못 고치는 것이고 이것은 **애초에 사람이 정하는 값이 아닌 것**이다. FIN-REQ-01의 요청 부서는 작성자의 소속이라 이 화면에서 고를 일이 없고, 디자인도 그 칸만 흐리게 그린 뒤 '작성자의 소속 부서로 고정됩니다'라고 적어 두었다. 고칠 수 없으므로 required도 될 수 없다."
    },
    "validation": {
      "type": "array",
      "readOnly": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule",
          "value"
        ],
        "properties": {
          "rule": {
            "type": "string",
            "enum": [
              "minLength",
              "maxLength",
              "minimum",
              "maximum",
              "pattern"
            ]
          },
          "value": {
            "type": [
              "string",
              "number",
              "integer"
            ]
          }
        }
      }
    }
  }
}
