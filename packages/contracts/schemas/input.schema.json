{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "input.schema.json",
  "title": "Input element",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "fieldKey",
    "label",
    "placeholder",
    "initialValue",
    "inputType",
    "valueType",
    "required",
    "validation"
  ],
  "properties": {
    "type": {
      "const": "input"
    },
    "fieldKey": {
      "type": "string",
      "minLength": 1
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "placeholder": {
      "type": [
        "string",
        "null"
      ]
    },
    "helperText": {
      "type": "string",
      "minLength": 1,
      "description": "필드 아래에 항상 표시하는 보조 설명(선택)."
    },
    "initialValue": {
      "type": [
        "string",
        "null"
      ]
    },
    "inputType": {
      "type": "string",
      "enum": [
        "text",
        "email",
        "password",
        "number",
        "tel",
        "url",
        "search",
        "date",
        "time",
        "datetime-local"
      ]
    },
    "valueType": {
      "type": "string",
      "enum": [
        "string",
        "integer",
        "number",
        "boolean"
      ]
    },
    "required": {
      "type": "boolean"
    },
    "validation": {
      "type": "array",
      "readOnly": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule",
          "value"
        ],
        "properties": {
          "rule": {
            "type": "string",
            "enum": [
              "minLength",
              "maxLength",
              "minimum",
              "maximum",
              "pattern"
            ]
          },
          "value": {
            "type": [
              "string",
              "number",
              "integer"
            ]
          }
        }
      }
    }
  }
}
