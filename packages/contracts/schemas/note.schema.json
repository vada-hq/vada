{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "note.schema.json",
  "title": "Note element",
  "description": "다른 상태 스코프의 필드 값을 읽어 표시하는 파생 표시 요소. 값이 동적이라 카피로 고정할 수 없는 안내에 쓴다. 구현은 fieldRefs의 표시 라벨을 separator로 이어 prefix 뒤에 렌더하며, 값이 없는 참조는 생략한다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "fieldRefs"
  ],
  "properties": {
    "type": {
      "const": "note"
    },
    "prefix": {
      "type": "string"
    },
    "separator": {
      "type": "string"
    },
    "fieldRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scope",
          "fieldKey"
        ],
        "properties": {
          "scope": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "fieldKey": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
