{
  "name": "vada-m1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev:web": "npm run dev --workspace @vada/web",
    "dev:api": "npm run dev --workspace @vada/api",
    "typecheck": "npm run typecheck --workspaces",
    "build": "npm run typecheck --workspace @vada/api && npm run build --workspace @vada/web",
    "start": "npm run start --workspace @vada/api",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives",
    "knip": "knip",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run knip"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "knip": "6.42.1",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  }
}
