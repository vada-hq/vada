{
  "name": "vada-m1",
  "private": true,
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev:web": "pnpm --filter @vada/web dev",
    "dev:api": "pnpm --filter @vada/api dev",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm --filter @vada/api typecheck && pnpm --filter @vada/web build",
    "start": "pnpm --filter @vada/api start",
    "test": "pnpm -r --if-present test && node --test .claude/hooks/block-db-commands.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives",
    "knip": "knip",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm knip"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "knip": "6.42.1",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@12.15.0"
}
