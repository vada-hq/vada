{
  "name": "@vada/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/serve.ts",
    "start": "tsx src/serve.ts --production",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "db:generate": "drizzle-kit generate --custom",
    "db:migrate": "tsx src/ops/migrate/migrate.ts",
    "test-data": "tsx scripts/manage-test-data.ts",
    "demo": "tsx scripts/manage-demo-data.ts",
    "showcase": "tsx scripts/manage-showcase.ts",
    "president-recovery": "tsx scripts/manage-president-recovery.ts",
    "privacy": "tsx scripts/manage-privacy.ts",
    "pg-smoke": "tsx scripts/pg-smoke.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.14",
    "@hono/node-server": "2.1.3",
    "@hono/standard-validator": "0.4.0",
    "@sentry/node": "11.4.0",
    "@standard-schema/spec": "1.1.0",
    "@vada/contracts": "workspace:*",
    "aws4fetch": "1.0.20",
    "better-auth": "1.7.14",
    "drizzle-orm": "0.45.3",
    "fflate": "0.8.3",
    "hono": "4.13.14",
    "postgres": "3.4.9",
    "tsx": "4.23.15",
    "web-push": "3.6.7",
    "write-excel-file": "4.1.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/web-push": "3.6.4",
    "drizzle-kit": "0.31.11",
    "zod": "4.6.7"
  }
}
