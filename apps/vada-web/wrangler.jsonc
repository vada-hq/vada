// 웹을 올리는 곳(Cloudflare Workers).
//
// **Pages가 아니라 Workers다(2026-09-02).** Cloudflare가 새 프로젝트에 권하는 쪽으로
// 옮겼다 — 정적 파일 제공이 무료라 값은 같고, Pages는 UI에서도 뒤로 물러났다.
//
// 옮기면서 얻은 것: 웹과 api가 **한 주소**가 된다. `/api/*`만 Worker가 받아 Render로
// 넘기고 나머지는 정적 파일이다. 브라우저가 보기에 둘이 같은 사이트이므로 CORS도
// 서드파티 쿠키도 없다 — 그 고장이 이 배포에서 가장 위험한 자리였다.
{
  "name": "vada",
  // **UTC로 적는다.** 한국이 9월 2일일 때 Cloudflare는 아직 9월 1일이고, 앞선
  // 날짜는 "미래 날짜는 쓸 수 없다"로 거부된다. 오늘 하루 차이가 아홉 시간이다.
  "compatibility_date": "2026-09-01",
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist/",
    // 주소는 `#/화면id`라 서버까지 오는 경로는 늘 `/`다. 그래도 적어 둔다 —
    // 나중에 해시를 버리면 이 줄이 없을 때 새로고침이 404가 된다.
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    // 이 자리만 Worker가 먼저 받는다. 나머지는 Worker를 거치지도 않는다.
    "run_worker_first": ["/api/*"]
  },
  // **api가 어디 있는지는 비밀이 아니다.** 누구나 여는 주소이므로 저장소에 둔다 —
  // 그러면 배포가 스스로를 설명하고, 대시보드에만 적어 두었다가 다음 배포에서
  // 지워지는 일도 없다(`wrangler deploy`는 설정 파일이 든 것으로 맞춘다).
  //
  // 비밀은 여기 두지 않는다. 그런 것이 생기면 `wrangler secret`으로 넣는다.
  "vars": {
    "API_ORIGIN": "https://vada-api-amd7.onrender.com"
  },
  "observability": { "enabled": true }
}
