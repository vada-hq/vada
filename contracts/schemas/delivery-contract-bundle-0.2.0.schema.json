{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vada.local/schemas/delivery-contract-bundle-0.2.0.json",
  "title": "VADA Delivery Contract Delta Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bundle_id",
    "bundle_revision",
    "bundle_status",
    "approval_source_ref",
    "updated_at",
    "delivery_unit_ref",
    "objective_ko",
    "standards_profile",
    "sources",
    "base_bundle_ref",
    "contracts",
    "questions"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": "0.2.0"
    },
    "bundle_id": {
      "type": "string",
      "pattern": "^CB-[A-Z0-9][A-Z0-9-]{2,}$"
    },
    "bundle_revision": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "integer",
          "minimum": 1
        }
      ]
    },
    "bundle_status": {
      "enum": [
        "defining",
        "review_ready",
        "approved"
      ]
    },
    "approval_source_ref": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^SRC-[0-9]{3,}$"
        }
      ]
    },
    "updated_at": {
      "type": "string",
      "minLength": 1
    },
    "solution_ref": {
      "$ref": "https://vada.local/schemas/delivery-contract-bundle-0.1.0.json#/$defs/solutionRef"
    },
    "delivery_unit_ref": {
      "type": "string",
      "pattern": "^(FLOW-[A-Z0-9][A-Z0-9-]*@R[1-9][0-9]*|SCREEN:[A-Z0-9][A-Z0-9-]*)$",
      "description": "product-specs 기반 묶음은 승인 플로우 리비전을, 화면 정본 기반 묶음은 SCREEN:<화면 ID>를 가리킨다."
    },
    "objective_ko": {
      "type": "string",
      "minLength": 1
    },
    "standards_profile": {
      "$ref": "https://vada.local/schemas/delivery-contract-bundle-0.1.0.json#/$defs/standardsProfile"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "https://vada.local/schemas/delivery-contract-bundle-0.1.0.json#/$defs/source"
      }
    },
    "base_bundle_ref": {
      "$ref": "#/$defs/baseBundleRef"
    },
    "contracts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://vada.local/schemas/delivery-contract-bundle-0.1.0.json#/$defs/contract"
      }
    },
    "design_coverage": {
      "type": "array",
      "items": {
        "$ref": "https://vada.local/schemas/delivery-contract-bundle-0.1.0.json#/$defs/designCoverage"
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "$ref": "https://vada.local/schemas/delivery-contract-bundle-0.1.0.json#/$defs/question"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "bundle_status": {
            "const": "approved"
          }
        },
        "required": [
          "bundle_status"
        ]
      },
      "then": {
        "properties": {
          "bundle_revision": {
            "type": "integer",
            "minimum": 1
          },
          "approval_source_ref": {
            "type": "string",
            "pattern": "^SRC-[0-9]{3,}$"
          }
        }
      },
      "else": {
        "properties": {
          "bundle_revision": {
            "type": "null"
          },
          "approval_source_ref": {
            "type": "null"
          }
        }
      }
    }
  ],
  "$defs": {
    "baseBundleRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundle_path",
        "bundle_id",
        "bundle_revision",
        "canonical_sha256"
      ],
      "properties": {
        "bundle_path": {
          "type": "string",
          "minLength": 1
        },
        "bundle_id": {
          "type": "string",
          "pattern": "^CB-[A-Z0-9][A-Z0-9-]{2,}$"
        },
        "bundle_revision": {
          "type": "integer",
          "minimum": 1
        },
        "canonical_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  },
  "$comment": "solution_ref와 design_coverage는 product-specs 기반 묶음에만 필요하다. 화면 정본(screens/)을 근거로 하는 묶음은 두 필드를 생략하고, 대신 새 API 계약을 참조하는 화면이 있어야 한다."
}
