{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vada.local/schemas/delivery-contract-bundle-0.1.0.json",
  "title": "VADA Delivery Contract Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bundle_id",
    "bundle_revision",
    "bundle_status",
    "approval_source_ref",
    "updated_at",
    "solution_ref",
    "delivery_unit_ref",
    "objective_ko",
    "standards_profile",
    "sources",
    "imports",
    "contracts",
    "design_coverage",
    "questions"
  ],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schema_version": { "const": "0.1.0" },
    "bundle_id": { "type": "string", "pattern": "^CB-[A-Z0-9][A-Z0-9-]{2,}$" },
    "bundle_revision": {
      "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 1 }]
    },
    "bundle_status": { "enum": ["defining", "review_ready", "approved"] },
    "approval_source_ref": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^SRC-[0-9]{3,}$" }
      ]
    },
    "updated_at": { "type": "string", "minLength": 1 },
    "solution_ref": { "$ref": "#/$defs/solutionRef" },
    "delivery_unit_ref": {
      "type": "string",
      "pattern": "^FLOW-[A-Z0-9][A-Z0-9-]*@R[1-9][0-9]*$"
    },
    "objective_ko": { "type": "string", "minLength": 1 },
    "standards_profile": { "$ref": "#/$defs/standardsProfile" },
    "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
    "imports": { "type": "array", "items": { "$ref": "#/$defs/contractImport" } },
    "contracts": { "type": "array", "items": { "$ref": "#/$defs/contract" } },
    "design_coverage": {
      "type": "array",
      "items": { "$ref": "#/$defs/designCoverage" }
    },
    "questions": { "type": "array", "items": { "$ref": "#/$defs/question" } }
  },
  "allOf": [
    {
      "if": {
        "properties": { "bundle_status": { "const": "approved" } },
        "required": ["bundle_status"]
      },
      "then": {
        "properties": {
          "bundle_revision": { "type": "integer", "minimum": 1 },
          "approval_source_ref": { "type": "string", "pattern": "^SRC-[0-9]{3,}$" }
        }
      },
      "else": {
        "properties": {
          "bundle_revision": { "type": "null" },
          "approval_source_ref": { "type": "null" }
        }
      }
    }
  ],
  "$defs": {
    "contractId": {
      "type": "string",
      "pattern": "^(DOMAIN|DATA|AUTH|API|ERROR|EVENT|QUALITY):[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*@R[1-9][0-9]*$"
    },
    "solutionRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "solution_id", "solution_revision", "canonical_sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "solution_id": {
          "type": "string",
          "pattern": "^SOLUTION-[A-Z0-9][A-Z0-9-]{2,}$"
        },
        "solution_revision": { "type": "integer", "minimum": 1 },
        "canonical_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "standardsProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["openapi_version", "json_schema_dialect", "http_problem_details"],
      "properties": {
        "openapi_version": { "const": "3.1.1" },
        "json_schema_dialect": {
          "const": "https://json-schema.org/draft/2020-12/schema"
        },
        "http_problem_details": { "const": "RFC9457" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "captured_at", "locator", "content_ko"],
      "properties": {
        "id": { "type": "string", "pattern": "^SRC-[0-9]{3,}$" },
        "type": {
          "enum": [
            "user_statement",
            "document",
            "standard",
            "repository_evidence",
            "observation",
            "system"
          ]
        },
        "captured_at": { "type": "string", "minLength": 1 },
        "locator": { "type": ["string", "null"] },
        "content_ko": { "type": "string", "minLength": 1 }
      }
    },
    "contractImport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_id",
        "bundle_path",
        "bundle_id",
        "bundle_revision",
        "canonical_sha256"
      ],
      "properties": {
        "contract_id": { "$ref": "#/$defs/contractId" },
        "bundle_path": { "type": "string", "minLength": 1 },
        "bundle_id": { "type": "string", "pattern": "^CB-[A-Z0-9][A-Z0-9-]{2,}$" },
        "bundle_revision": { "type": "integer", "minimum": 1 },
        "canonical_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "key",
        "revision",
        "status",
        "change_class",
        "supersedes",
        "summary_ko",
        "specification",
        "source_refs"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/contractId" },
        "kind": { "enum": ["DOMAIN", "DATA", "AUTH", "API", "ERROR", "EVENT", "QUALITY"] },
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
        },
        "revision": { "type": "integer", "minimum": 1 },
        "status": { "enum": ["proposed", "ratified"] },
        "change_class": { "enum": ["initial", "editorial", "additive", "breaking"] },
        "supersedes": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/contractId" }]
        },
        "summary_ko": { "type": "string", "minLength": 1 },
        "specification": { "type": "object", "minProperties": 1 },
        "source_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^SRC-[0-9]{3,}$" }
        }
      }
    },
    "designCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["design_ref", "disposition", "contract_refs", "rationale_ko"],
      "properties": {
        "design_ref": {
          "type": "string",
          "pattern": "^DESIGN-[A-Z0-9][A-Z0-9-]*$"
        },
        "disposition": { "enum": ["contracted", "direct_task_input"] },
        "contract_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/contractId" }
        },
        "rationale_ko": { "type": "string", "minLength": 1 }
      }
    },
    "normalizedAnswer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selected_option_ids", "free_text"],
      "properties": {
        "selected_option_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_-]*$" }
        },
        "free_text": {
          "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }]
        }
      }
    },
    "questionOption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label_ko"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9_-]*$" },
        "label_ko": { "type": "string", "minLength": 1 }
      }
    },
    "responseDesign": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basis", "rationale_ko", "source_refs"],
      "properties": {
        "basis": {
          "enum": [
            "logical_partition",
            "source_backed_options",
            "observed_answers",
            "external_standard",
            "typed_value",
            "unbounded_answer_space"
          ]
        },
        "rationale_ko": { "type": "string", "minLength": 1 },
        "source_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^SRC-[0-9]{3,}$" }
        }
      }
    },
    "questionEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["solution_design_refs", "source_refs"],
      "properties": {
        "solution_design_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^DESIGN-[A-Z0-9][A-Z0-9-]*$" }
        },
        "source_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^SRC-[0-9]{3,}$" }
        }
      },
      "anyOf": [
        { "properties": { "solution_design_refs": { "type": "array", "minItems": 1 } } },
        { "properties": { "source_refs": { "type": "array", "minItems": 1 } } }
      ]
    },
    "activationCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question_ref", "operator", "option_ids"],
      "properties": {
        "question_ref": { "type": "string", "pattern": "^Q-[0-9]{3,}$" },
        "operator": { "const": "selected_option_any_of" },
        "option_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_-]*$" }
        }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "decision_area",
        "origin",
        "depends_on_question_refs",
        "activation_conditions",
        "kind",
        "response_design",
        "question_ko",
        "reason_ko",
        "target_path",
        "blocks_next_step",
        "options",
        "evidence",
        "answer_source_ref",
        "normalized_answer",
        "dismissal_reason_ko"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^Q-[0-9]{3,}$" },
        "status": { "enum": ["pending", "answered", "deferred", "dismissed"] },
        "decision_area": {
          "enum": ["domain", "data", "authorization", "api", "error", "event", "quality", "approval", "other"]
        },
        "origin": { "enum": ["initial_plan", "answer_follow_up", "late_discovery", "approval"] },
        "depends_on_question_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^Q-[0-9]{3,}$" }
        },
        "activation_conditions": {
          "type": "array",
          "items": { "$ref": "#/$defs/activationCondition" }
        },
        "kind": { "enum": ["yes_no", "single_choice", "multiple_choice", "short_text", "open_text"] },
        "response_design": { "$ref": "#/$defs/responseDesign" },
        "question_ko": { "type": "string", "minLength": 1 },
        "reason_ko": { "type": "string", "minLength": 1 },
        "target_path": { "type": "string", "pattern": "^/.+" },
        "blocks_next_step": { "type": "boolean" },
        "options": {
          "oneOf": [
            { "type": "null" },
            { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/questionOption" } }
          ]
        },
        "evidence": { "$ref": "#/$defs/questionEvidence" },
        "answer_source_ref": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^SRC-[0-9]{3,}$" }
          ]
        },
        "normalized_answer": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/normalizedAnswer" }]
        },
        "dismissal_reason_ko": {
          "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "kind": { "enum": ["yes_no", "single_choice", "multiple_choice"] } },
            "required": ["kind"]
          },
          "then": { "properties": { "options": { "type": "array", "minItems": 2 } } },
          "else": { "properties": { "options": { "type": "null" } } }
        },
        {
          "if": {
            "properties": { "status": { "const": "pending" } },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "answer_source_ref": { "type": "null" },
              "normalized_answer": { "type": "null" },
              "dismissal_reason_ko": { "type": "null" }
            }
          },
          "else": {
            "if": {
              "properties": { "status": { "const": "dismissed" } },
              "required": ["status"]
            },
            "then": {
              "properties": {
                "answer_source_ref": { "type": "string", "pattern": "^SRC-[0-9]{3,}$" },
                "normalized_answer": { "type": "null" },
                "dismissal_reason_ko": { "type": "string", "minLength": 1 }
              }
            },
            "else": {
              "properties": {
                "answer_source_ref": { "type": "string", "pattern": "^SRC-[0-9]{3,}$" },
                "normalized_answer": { "$ref": "#/$defs/normalizedAnswer" },
                "dismissal_reason_ko": { "type": "null" }
              }
            }
          }
        }
      ]
    }
  }
}
