  },
  "contracts": [
    {
      "id": "DATA:event_budget.summary@R1",
      "kind": "DATA",
      "key": "event_budget.summary",
      "revision": 1,
      "status": "ratified",
      "change_class": "initial",
      "supersedes": null,
      "summary_ko": "행사 예산의 항목별 배정액과 집행 예정액, 사용 가능액을 정의합니다.",
      "specification": {
        "json_schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "$id": "urn:vada:schema:event-budget-summary:r1",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "eventId",
            "allocations",
            "allocatedTotal",
            "committedTotal",
            "availableTotal"
          ],
          "properties": {
            "eventId": {
              "type": "string",
              "minLength": 1
            },
            "allocations": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "budgetItem",
                  "allocatedAmount",
                  "committedAmount",
                  "availableAmount"
                ],
                "properties": {
                  "budgetItem": {
                    "type": "string",
                    "minLength": 1
                  },
                  "allocatedAmount": {
                    "type": "number",
                    "minimum": 0
                  },
                  "committedAmount": {
                    "type": "number",
                    "minimum": 0
                  },
                  "availableAmount": {
                    "type": "number"
                  }
                }
              }
            },
            "allocatedTotal": {
              "type": "number",
              "minimum": 0
            },
            "committedTotal": {
              "type": "number",
              "minimum": 0
            },
            "availableTotal": {
              "type": "number"
            }
          }
        },
        "semantic_notes_ko": [
          "budgetItem은 구매 요청 품목의 예산 항목과 같은 어휘를 씁니다.",
          "committedAmount는 승인 또는 부분 승인된 요청의 해당 항목 금액 합계이며 실제 지출이 아닙니다.",
          "availableAmount는 allocatedAmount에서 committedAmount를 뺀 값이며 음수가 될 수 있습니다.",
          "구매 실행과 증빙에 따른 실제 지출액은 후속 흐름에서 정의하므로 이 계약에 넣지 않습니다."
        ],
        "schema_contract_refs": []
      },
      "source_refs": [
        "SRC-001",
        "SRC-003"
      ]
    },
    {
      "id": "DATA:purchase_request.event_list@R1",
      "kind": "DATA",
      "key": "purchase_request.event_list",
      "revision": 1,
      "status": "ratified",
      "change_class": "initial",
      "supersedes": null,
      "summary_ko": "행사의 모든 구매 요청을 처리 상태와 요청 부서와 함께 정의합니다.",
      "specification": {
        "json_schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "$id": "urn:vada:schema:purchase-request-event-list:r1",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "items"
          ],
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "requestId",
                  "title",
                  "status",
                  "estimatedTotal",
                  "overBudget",
                  "createdAt",
                  "requestDepartmentName",
                  "priority"
                ],
                "properties": {
                  "requestId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "status": {
                    "enum": [
                      "review_pending",
                      "approved",
                      "partially_approved",
                      "revision_requested",
                      "rejected"
                    ]
                  },
                  "estimatedTotal": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "overBudget": {
                    "type": "boolean"
                  },
                  "createdAt": {
                    "type": "string",
                    "minLength": 1
                  },
                  "requestDepartmentName": {
                    "type": "string",
                    "minLength": 1
                  },
                  "priority": {
                    "enum": [
                      "normal",
                      "urgent"
                    ]
                  }
                }
              }
            }
          }
        },
        "semantic_notes_ko": [
          "items는 createdAt 내림차순으로 정렬합니다.",
          "현재 행사의 모든 요청을 포함하며 요청자 본인 여부로 거르지 않습니다.",
          "status는 검토 단계까지만 정의합니다. 구매와 증빙, 정산 상태는 후속 흐름에서 추가합니다.",
          "requestDepartmentName은 서버가 해석한 표시명이며 클라이언트가 식별자에서 추정하지 않습니다."
        ],
        "schema_contract_refs": []
      },
      "source_refs": [
        "SRC-001",
        "SRC-003"
      ]
    },
    {
      "id": "AUTH:event_budget.read@R1",
      "kind": "AUTH",
      "key": "event_budget.read",
      "revision": 1,
      "status": "ratified",
      "change_class": "initial",
      "supersedes": null,
      "summary_ko": "행사 구성원이 이 행사의 예산 현황을 읽게 합니다.",
      "specification": {
        "action": "event_budget.read",
        "resource_ko": "현재 행사의 예산 배정과 집행 예정 현황",
        "default_decision": "deny",
        "enforcement": "trusted_server",
        "allow_any": [
          {
            "all_of": [
              {
                "left_fact": "actor.has_active_organization_membership",
                "operator": "is_true",
                "right": {
                  "literal": true
                }
              },
              {
                "left_fact": "event.organization_id",
                "operator": "equals",
                "right": {
                  "fact": "context.organization_id"
                }
              }
            ]
          }
        ]
      },
      "source_refs": [
        "SRC-001",
        "SRC-002"
      ]
    },
    {
