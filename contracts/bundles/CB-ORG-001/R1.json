  "contracts": [
    {
      "id": "DATA:organization.member_roles@R1",
      "kind": "DATA",
      "key": "organization.member_roles",
      "revision": 1,
      "status": "ratified",
      "change_class": "initial",
      "supersedes": null,
      "summary_ko": "학생회 구성원의 기본 역할과 소속 부서 목록을 정의합니다.",
      "specification": {
        "json_schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "$id": "urn:vada:schema:organization-member-roles:r1",
          "type": "object",
          "additionalProperties": false,
          "required": ["members"],
          "properties": {
            "members": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["membershipId", "displayName", "departments", "role"],
                "properties": {
                  "membershipId": { "type": "string", "minLength": 1 },
                  "displayName": {
                    "type": "string",
                    "minLength": 1,
                    "description": "구성원 이름. 표시 전용이며 이것으로 구성원을 가리키지 않는다"
                  },
                  "departments": {
                    "type": "array",
                    "items": { "type": "string", "minLength": 1 },
                    "description": "소속 부서 이름. 한 구성원이 여러 부서에 속할 수 있어 목록이다"
                  },
                  "role": {
                    "type": "string",
                    "enum": ["president", "department_head", "member"]
                  }
                }
              }
            }
          }
        },
        "semantic_notes_ko": [
          "role은 저장값입니다. 회장단·부서장·부원이라는 표시 이름은 화면이 붙입니다. 저장값과 표시값을 같은 자리에 섞지 않습니다.",
          "재정부는 여기 담기지 않습니다. 재정부는 직급이 아니라 부서 조건이므로 departments에 나타납니다.",
          "구성원은 membershipId로 가리킵니다. 동명이인이 있으면 이름으로 가리키는 방식은 두 사람을 함께 바꿉니다.",
          "이 응답은 세션이 정한 조직의 구성원만 담습니다. 다른 조직의 구성원은 어떤 경우에도 섞이지 않습니다.",
          "departments가 빈 배열이면 아직 어느 부서에도 배정되지 않은 구성원입니다. 기본 역할은 부서 배정과 무관하게 존재합니다."
        ]
      },
      "source_refs": ["SRC-001", "SRC-003"]
    },
    {
      "id": "DATA:organization.role_change_command@R1",
      "kind": "DATA",
      "key": "organization.role_change_command",
      "revision": 1,
      "status": "ratified",
      "change_class": "initial",
      "supersedes": null,
      "summary_ko": "한 구성원의 기본 역할을 바꾸는 명령을 정의합니다.",
      "specification": {
        "json_schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "$id": "urn:vada:schema:organization-role-change-command:r1",
          "type": "object",
          "additionalProperties": false,
          "required": ["role", "expectedCurrentRole"],
          "properties": {
            "role": {
              "type": "string",
              "enum": ["president", "department_head", "member"],
              "description": "바꾸려는 기본 역할"
            },
            "expectedCurrentRole": {
              "type": "string",
              "enum": ["president", "department_head", "member"],
              "description": "화면이 본 현재 기본 역할. 서버 값과 다르면 거부한다"
            }
          }
        },
        "semantic_notes_ko": [
          "expectedCurrentRole은 낙관적 잠금입니다. 두 회장단이 같은 구성원을 동시에 바꾸면 나중 요청이 앞선 변경을 덮어쓰지 않고 충돌로 거부됩니다.",
          "role과 expectedCurrentRole이 같으면 바꿀 것이 없으므로 거부합니다. 조용히 성공으로 처리하면 화면이 바뀌지 않은 것을 바뀐 것으로 보여줍니다.",
          "이 명령은 기본 역할 하나만 바꿉니다. 부서 배정과 회의·행사별 맥락 역할은 이 명령의 결과로 바뀌지 않습니다."
        ]
      },
      "source_refs": ["SRC-002", "SRC-003"]
    },
    {
      "id": "AUTH:organization.manage_member_roles@R1",
      "kind": "AUTH",
      "key": "organization.manage_member_roles",
      "revision": 1,
      "status": "ratified",
      "change_class": "initial",
      "supersedes": null,
      "summary_ko": "회장단만 구성원의 기본 역할을 읽고 바꿀 수 있게 합니다.",
      "specification": {
        "action": "organization.manage_member_roles",
        "resource_ko": "세션이 정한 조직의 구성원 기본 역할",
        "default_decision": "deny",
        "enforcement": "trusted_server",
        "allow_any": [
          {
            "all_of": [
              {
                "left_fact": "actor.has_active_organization_membership",
                "operator": "is_true",
                "right": { "literal": true }
              },
              {
                "left_fact": "actor.organization_role",
                "operator": "equals",
                "right": { "literal": "president" }
              }
            ]
          }
        ]
      },
      "source_refs": ["SRC-001", "SRC-003"]
    },
