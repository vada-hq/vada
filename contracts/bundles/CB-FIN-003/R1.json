  "contracts": [
    {
      "id": "DATA:purchase_request.item_review_state@R1",
      "kind": "DATA",
      "key": "purchase_request.item_review_state",
      "revision": 1,
      "status": "ratified",
      "change_class": "initial",
      "supersedes": null,
      "summary_ko": "구매 품목 하나의 검토 상태와 그 결정에 딸린 값을 정의합니다.",
      "specification": {
        "json_schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "$id": "urn:vada:schema:purchase-request-item-review-state:r1",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "itemId",
            "reviewStatus"
          ],
          "properties": {
            "itemId": {
              "type": "string",
              "minLength": 1
            },
            "reviewStatus": {
              "type": "string",
              "enum": [
                "review_pending",
                "approved",
                "revision_requested",
                "rejected"
              ],
              "description": "품목의 검토 상태. 저장되는 원본이다"
            },
            "revisionReason": {
              "type": "string",
              "minLength": 1,
              "description": "보완 요청 사유. reviewStatus가 revision_requested일 때만 존재한다"
            },
            "revisionDueDate": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
              "description": "보완 재제출 기한. reviewStatus가 revision_requested일 때만 존재한다"
            },
            "rejectionReason": {
              "type": "string",
              "minLength": 1,
              "description": "반려 사유. reviewStatus가 rejected일 때만 존재한다"
            }
          }
        },
        "semantic_notes_ko": [
          "검토 대기에서 승인과 보완 요청, 반려로 바로 전환합니다. 별도 검토 중 단계를 두지 않습니다.",
          "승인에는 금액 입력이 없습니다. 품목의 요청 금액을 그대로 예산 예약하므로 승인액 필드를 두지 않습니다. 금액이 문제라면 보완 요청입니다.",
          "반려 사유는 자유 입력입니다. 시스템이 사유 목록이나 추천을 제공하지 않습니다.",
          "보완 요청에는 사유와 재제출 기한이 모두 필요합니다. 기한이 지난 뒤의 처리는 이 리비전이 정하지 않으며 기록하고 표시만 합니다.",
          "결정은 품목 단위입니다. 한 구매 요청 안에서 품목마다 다른 상태가 되는 것이 정상입니다.",
          "구매 요청 수준의 통합 진행 상태를 만들지 않습니다. 요청의 상태는 소속 품목의 개별 상태로만 표현합니다."
        ],
        "schema_contract_refs": []
      },
      "source_refs": [
        "SRC-001",
        "SRC-002"
      ]
    },
    {
      "id": "DATA:purchase_request.review_view@R1",
      "kind": "DATA",
      "key": "purchase_request.review_view",
      "revision": 1,
      "status": "ratified",
      "change_class": "initial",
      "supersedes": null,
      "summary_ko": "검토 화면이 한 번에 읽는 요청 내용과 품목별 검토 상태, 처리 기록을 정의합니다.",
      "specification": {
        "json_schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "$id": "urn:vada:schema:purchase-request-review-view:r1",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "detail",
            "itemReviewStates",
            "history"
          ],
          "properties": {
            "detail": {
              "$ref": "urn:vada:schema:purchase-request-detail-view:r1"
            },
            "itemReviewStates": {
              "type": "array",
              "items": {
                "$ref": "urn:vada:schema:purchase-request-item-review-state:r1"
              }
            },
            "history": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "recordedAt",
                  "actorName",
                  "summary"
                ],
                "properties": {
                  "recordedAt": {
                    "type": "string",
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]+)?Z$",
                    "description": "UTC ISO 8601. 저장은 UTC, 표시만 KST로 바꾼다"
                  },
                  "actorName": {
                    "type": "string",
                    "minLength": 1
                  },
                  "summary": {
                    "type": "string",
                    "minLength": 1
                  },
                  "itemId": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        "semantic_notes_ko": [
          "itemReviewStates는 detail의 품목마다 정확히 하나씩 있습니다. 아직 결정하지 않은 품목도 review_pending으로 존재합니다.",
          "history는 오래된 것부터 시간순입니다. 요청자와 재정부가 같은 이력을 봅니다.",
          "history의 itemId는 품목 단위 사건일 때만 존재합니다. 요청 제출처럼 요청 전체의 사건에는 없습니다.",
          "recordedAt은 UTC로 저장하고 표시만 KST로 바꿉니다.",
          "actorName은 표시 전용입니다. 권한 판정이나 다른 조회의 식별자로 쓸 수 없습니다."
        ],
        "schema_contract_refs": [
          "DATA:purchase_request.detail_view@R1",
          "DATA:purchase_request.item_review_state@R1"
        ]
      },
      "source_refs": [
        "SRC-001",
        "SRC-002"
      ]
    },
    {
      "id": "DATA:purchase_request.item_decision@R1",
      "kind": "DATA",
      "key": "purchase_request.item_decision",
      "revision": 1,
      "status": "ratified",
      "change_class": "initial",
      "supersedes": null,
      "summary_ko": "재정부가 품목 하나에 내리는 검토 결정 입력을 정의합니다.",
      "specification": {
        "json_schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "$id": "urn:vada:schema:purchase-request-item-decision:r1",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "decision",
            "expectedReviewStatus"
          ],
          "properties": {
            "decision": {
              "type": "string",
              "enum": [
                "approve",
                "request_revision",
                "reject"
              ]
            },
            "expectedReviewStatus": {
              "type": "string",
              "enum": [
                "review_pending",
                "approved",
                "revision_requested",
                "rejected"
              ],
              "description": "요청자가 화면에서 본 현재 상태. 서버 상태와 다르면 거부한다"
            },
            "revisionReason": {
              "type": "string",
              "minLength": 1
            },
            "revisionDueDate": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            "rejectionReason": {
              "type": "string",
              "minLength": 1
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "decision": {
                    "const": "request_revision"
                  }
                },
                "required": [
                  "decision"
                ]
              },
              "then": {
                "properties": {
                  "revisionReason": {
                    "type": "string",
                    "minLength": 1
                  },
                  "revisionDueDate": {
                    "type": "string",
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                  }
                },
                "required": [
                  "revisionReason",
                  "revisionDueDate"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "decision": {
                    "const": "reject"
                  }
                },
                "required": [
                  "decision"
                ]
              },
              "then": {
                "properties": {
                  "rejectionReason": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "rejectionReason"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "decision": {
                    "const": "approve"
                  }
                },
                "required": [
                  "decision"
                ]
              },
              "then": {
                "not": {
                  "anyOf": [
                    {
                      "properties": {
                        "revisionReason": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "revisionReason"
                      ]
                    },
                    {
                      "properties": {
                        "revisionDueDate": {
                          "type": "string",
                          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                        }
                      },
                      "required": [
                        "revisionDueDate"
                      ]
                    },
                    {
                      "properties": {
                        "rejectionReason": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "rejectionReason"
                      ]
                    }
                  ]
                }
              }
            }
          ]
        },
        "semantic_notes_ko": [
          "승인에는 금액 입력이 없습니다. 요청 금액을 그대로 예약하므로 승인액을 받지 않습니다.",
          "보완 요청은 사유와 재제출 기한이 모두 필요합니다. 하나만 보내면 거부합니다.",
          "반려는 사유가 필요합니다. 시스템이 사유 목록을 주지 않으므로 자유 입력을 받습니다.",
          "expectedReviewStatus는 낙관적 잠금입니다. 다른 사람이 먼저 처리했으면 서버가 409로 거부하고 덮어쓰지 않습니다.",
          "결정은 품목 단위로 개별 저장합니다. 미검토 품목이 남아 있어도 막지 않습니다.",
          "재제출 기한이 지난 뒤의 처리는 이 리비전이 정하지 않습니다."
        ],
        "schema_contract_refs": []
      },
      "source_refs": [
        "SRC-001",
        "SRC-002",
        "SRC-003"
      ]
    },
    {
      "id": "AUTH:purchase_request.review@R1",
      "kind": "AUTH",
      "key": "purchase_request.review",
      "revision": 1,
      "status": "ratified",
      "change_class": "initial",
      "supersedes": null,
      "summary_ko": "행사가 속한 조직의 재정부 구성원만 구매 품목의 검토 결정을 읽고 바꿀 수 있게 합니다.",
      "specification": {
        "action": "purchase_request.review",
        "resource_ko": "현재 조직 범위에 속한 행사의 구매 요청과 그 품목의 검토 상태",
        "default_decision": "deny",
        "enforcement": "trusted_server",
        "allow_any": [
          {
            "all_of": [
              {
                "left_fact": "actor.has_active_organization_membership",
                "operator": "is_true",
                "right": {
                  "literal": true
                }
              },
              {
                "left_fact": "request.organization_id",
                "operator": "equals",
                "right": {
                  "fact": "context.organization_id"
                }
              },
              {
                "left_fact": "actor.finance_member_of",
                "operator": "contains",
                "right": {
                  "fact": "context.organization_id"
                }
              }
            ]
          }
        ]
      },
      "source_refs": [
        "SRC-001",
        "SRC-002"
      ]
    },
    {
