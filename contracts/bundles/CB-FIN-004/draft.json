    {
      "id": "AUTH:purchase_request.resubmit_revision@R1",
      "kind": "AUTH",
      "key": "purchase_request.resubmit_revision",
      "revision": 1,
      "status": "proposed",
      "change_class": "initial",
      "supersedes": null,
      "summary_ko": "그 구매 요청의 요청자 본인만 보완 재제출할 수 있게 합니다.",
      "specification": {
        "action": "purchase_request.resubmit_revision",
        "resource_ko": "현재 조직 범위에 속한 구매 요청의 보완 대상 품목",
        "default_decision": "deny",
        "enforcement": "trusted_server",
        "allow_any": [
          {
            "all_of": [
              {
                "left_fact": "actor.has_active_organization_membership",
                "operator": "is_true",
                "right": {
                  "literal": true
                }
              },
              {
                "left_fact": "request.organization_id",
                "operator": "equals",
                "right": {
                  "fact": "context.organization_id"
                }
              },
              {
                "left_fact": "request.requester_user_id",
                "operator": "equals",
                "right": {
                  "fact": "context.user_id"
                }
              }
            ]
          }
        ]
      },
      "source_refs": [
        "SRC-003"
      ]
    },
