      "kind": "single_choice",
      "response_design": {
        "basis": "logical_partition",
        "rationale_ko": "이전 제출본을 화면에 보여줄지 말지는 서로 배타적인 두 갈래이고, 보여준다면 어디까지 보여줄지가 세 번째 갈래입니다.",
        "source_refs": [
          "SRC-002"
        ]
      },
      "question_ko": "재제출 화면에서 이전 보완 제출본을 요청자에게 보여줍니까?",
      "reason_ko": "재정 명세 §7은 보완 전·후 내용을 모두 보존하라고 정하지만 화면에 무엇을 보여줄지는 정하지 않았습니다. 보여준다면 조회 계약이 제출본 목록을 담아야 하고, 보여주지 않는다면 가장 최근 제출본만 담습니다. 계약의 모양이 달라집니다.",
      "target_path": "/contracts/DATA:purchase_request.revision_view@R1",
      "blocks_next_step": true,
      "options": [
        {
          "id": "LATEST_ONLY",
          "label_ko": "가장 최근 제출본만 보여준다"
        },
