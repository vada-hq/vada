      "id": "DATA:purchase_request.detail_view@R1",
      "kind": "DATA",
      "key": "purchase_request.detail_view",
      "revision": 1,
      "status": "proposed",
      "change_class": "initial",
      "supersedes": null,
      "summary_ko": "저장된 구매 요청과 신뢰 가능한 화면 표시 맥락을 함께 정의합니다.",
      "specification": {
        "json_schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "$id": "urn:vada:schema:purchase-request-detail-view:r1",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "record",
            "display"
          ],
          "properties": {
            "record": {
              "$ref": "urn:vada:schema:purchase-request-record:r1"
            },
            "display": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "eventName",
                "requesterName"
              ],
              "properties": {
                "eventName": {
                  "type": "string",
                  "minLength": 1
                },
                "requesterName": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "semantic_notes_ko": [
          "record의 eventId와 requesterUserId가 관계·권한·연결의 정본이며 display 값은 화면 표시 전용입니다.",
          "서버는 저장된 식별자에 대응하는 신뢰 가능한 행사명과 요청자명을 조회 시점에 반환하며 클라이언트가 이름을 추정하지 않습니다.",
          "display 값은 권한 판정이나 다른 리소스 조회의 식별자로 사용할 수 없습니다."
        ],
        "schema_contract_refs": [
          "DATA:purchase_request.record@R1"
        ]
      },
      "source_refs": [
        "SRC-001",
        "SRC-002",
        "SRC-003",
        "SRC-009"
      ]
    },
    {
      "id": "API:purchase_request.get_detail@R2",
      "kind": "API",
      "key": "purchase_request.get_detail",
      "revision": 2,
      "status": "proposed",
      "change_class": "breaking",
      "supersedes": "API:purchase_request.get_detail@R1",
      "summary_ko": "현재 조직 구성원이 요청 상세와 서버가 해석한 행사·요청자 표시명을 함께 조회합니다.",
      "specification": {
        "operation_id": "getPurchaseRequestDetail",
        "method": "GET",
        "path": "/events/{eventId}/purchase-requests/{requestId}",
        "authorization_ref": "AUTH:purchase_request.read_detail@R1",
        "request": {
          "body_contract_ref": "DATA:http.empty_body@R1",
          "parameters": [
            {
              "name": "eventId",
              "in": "path",
              "required": true,
              "schema": {
                "type": "string",
                "minLength": 1
              }
            },
            {
              "name": "requestId",
              "in": "path",
              "required": true,
              "schema": {
                "type": "string",
                "minLength": 1
              }
            }
          ]
        },
        "success": {
          "http_status": 200,
          "body_contract_ref": "DATA:purchase_request.detail_view@R1"
        },
        "error_refs": [
          "ERROR:http.unauthenticated@R1",
          "ERROR:http.resource_not_found@R1",
          "ERROR:purchase_request.persistence_unavailable@R1"
        ]
      },
      "source_refs": [
        "SRC-001",
        "SRC-002",
        "SRC-003",
        "SRC-006",
        "SRC-009"
      ]
    }
