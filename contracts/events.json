{
  "schemaVersion": 1,
  "kind": "event-contracts",
  "revisions": [
    {
      "id": "DATA:event.create@R1",
      "kind": "DATA",
      "key": "event.create",
      "revision": 1,
      "status": "active",
      "changeClass": "initial",
      "owners": ["제품", "백엔드"],
      "effectiveOn": "2026-07-26",
      "contract": {
        "requiredInput": ["name"],
        "constraints": {
          "name": "trim 후 한 글자 이상",
          "organizationId": "현재 인증 멤버십에서 서버가 결정",
          "initialLifecycle": "planning"
        },
        "extensionRule": "선택 입력 추가는 호환 추가 리비전, 새 필수 입력은 파괴적 리비전으로 처리한다."
      }
    },
    {
      "id": "DATA:event.basic_info@R1",
      "kind": "DATA",
      "key": "event.basic_info",
      "revision": 1,
      "status": "active",
      "changeClass": "initial",
      "owners": ["제품", "백엔드"],
      "effectiveOn": "2026-07-26",
      "contract": {
        "fields": [
          "name",
          "summary",
          "purpose",
          "startsAt",
          "endsAt",
          "endTimeUndecided",
          "venueName",
          "venueAddress",
          "venueDetail",
          "audience",
          "feeType",
          "feeAmount",
          "paymentInstructions",
          "capacityType",
          "capacity",
          "ownerDepartment",
          "ownerMember",
          "contact",
          "participantNotes"
        ],
        "sourceOfTruth": "행사 ID에 연결된 기본정보 레코드 하나",
        "consumerRule": "개요·일정·설문·공지 화면은 이 값을 읽고 중복 원본을 만들지 않는다."
      }
    },
    {
      "id": "DOMAIN:event.lifecycle@R1",
      "kind": "DOMAIN",
      "key": "event.lifecycle",
      "revision": 1,
      "status": "active",
      "changeClass": "initial",
      "owners": ["제품", "백엔드"],
      "effectiveOn": "2026-07-26",
      "contract": {
        "states": ["planning", "active", "wrap_up", "completed", "cancelled"],
        "labels": {
          "planning": "기획 중",
          "active": "진행 중",
          "wrap_up": "후속 정리 중",
          "completed": "완료",
          "cancelled": "취소됨"
        },
        "initialState": "planning",
        "normalTransitions": [
          ["planning", "active"],
          ["active", "wrap_up"],
          ["wrap_up", "completed"]
        ],
        "exceptionStates": ["cancelled"]
      }
    },
    {
      "id": "DOMAIN:event.field_state@R1",
      "kind": "DOMAIN",
      "key": "event.field_state",
      "revision": 1,
      "status": "active",
      "changeClass": "initial",
      "owners": ["제품", "프론트엔드", "백엔드"],
      "effectiveOn": "2026-07-26",
      "contract": {
        "states": ["decided", "undecided"],
        "projection": {
          "decided": "유효한 값을 표시한다.",
          "undecided": "빈칸 대신 미정을 표시한다."
        },
        "storageRule": "값의 유무로 파생하며 같은 의미를 별도 상태 필드에 중복 저장하지 않는다."
      }
    },
    {
      "id": "DATA:event.lifecycle_transition@R1",
      "kind": "DATA",
      "key": "event.lifecycle_transition",
      "revision": 1,
      "status": "review",
      "changeClass": "initial",
      "owners": ["제품", "백엔드"],
      "decisionNeeded": "조건부 상태 전환 요청, 전환 감사 이력, 남은 항목 요약의 필드와 계산 기준을 확정한다.",
      "fixedBoundary": {
        "request": ["expectedLifecycle", "nextLifecycle"],
        "conflictRule": "서버의 현재 상태가 예상 상태와 다르면 데이터를 바꾸지 않고 충돌로 거부한다."
      }
    },
    {
      "id": "POLICY:event.creation_handoff@R1",
      "kind": "POLICY",
      "key": "event.creation_handoff",
      "revision": 1,
      "status": "review",
      "changeClass": "initial",
      "owners": ["제품 정책"],
      "decisionNeeded": "event.create 보유자가 event.basic_info.update를 보유하지 않을 때 생성 직후의 편집 연속성을 어떤 규칙으로 보장할지 확정한다.",
      "allowedResolutionTypes": [
        "생성자를 행사 운영 조직 관리자로 지정",
        "생성자에게 제한된 초기 설정 권한 부여",
        "생성과 동시에 별도 운영 관리자를 지정"
      ]
    },
    {
      "id": "POLICY:event.field_not_applicable@R1",
      "kind": "POLICY",
      "key": "event.field_not_applicable",
      "revision": 1,
      "status": "review",
      "changeClass": "initial",
      "owners": ["제품 정책"],
      "decisionNeeded": "어떤 기본정보 필드에 해당 없음 상태를 허용할지와 저장 표현을 확정한다.",
      "scopeRule": "결정 전에는 미정과 해당 없음을 같은 값으로 저장하거나 표시하지 않는다."
    }
  ]
}
