DATABASE_URL=
BETTER_AUTH_SECRET=
# 브라우저가 접근하는 주소. 로컬 웹의 /api 프록시를 사용한다.
BETTER_AUTH_URL=http://127.0.0.1:5180
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 구매 초안 생성. 이전 검증에서 사용한 키와 모델을 재사용한다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# 미설정/조회 실패 시 상품 정보와 가격은 미확인으로 남긴다.
REEF_API_KEY=

# 사진 저장소(Cloudflare R2). 없으면 사진만 503
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# 쿠팡 상품 정보 불러오기(ReefAPI, DEC-89). 선택 값이다. 없으면 불러오기만 꺼지고 사람이 품목을 적는다.
REEF_API_KEY=
