# 이 파일을 .env로 복사하고 값을 채운다. .env는 커밋되지 않는다.
# 값을 대화창이나 커밋 메시지에 붙여넣지 마라. 한 번 새면 비밀이 아니다.

# 개발용 PostgreSQL. Neon이라면 대시보드의 연결 문자열을 쓰되,
# 앞의 postgresql:// 를 postgresql+psycopg:// 로 바꾼다.
VADA_DATABASE_URL=postgresql+psycopg://user:password@host/dbname?sslmode=require

# 일회용 빈 데이터베이스. 통합 테스트가 표를 만들고 지운다.
# VADA_DATABASE_URL과 같은 것을 쓰지 마라 — 시드가 지워진다.
VADA_TEST_DATABASE_URL=postgresql+psycopg://user:password@host/dbname_test?sslmode=require

# 로컬에는 API Gateway가 없어 인증 주체가 비어 있다. 이 둘이 그 자리를 채운다.
# subject를 바꾸면 다른 사람으로 화면을 볼 수 있다. `just seed`가 목록을 찍는다.
VADA_LOCAL_PRINCIPAL_ISSUER=https://cognito-idp.ap-northeast-2.amazonaws.com/local-pool
VADA_LOCAL_PRINCIPAL_SUBJECT=user-president
