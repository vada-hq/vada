{
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "findings"],
  "properties": {
    "verdict": { "type": "string", "enum": ["pass", "fix"] },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "bug_class", "file", "line", "failure", "summary"],
        "properties": {
          "severity": { "type": "string", "enum": ["Critical", "Important"] },
          "bug_class": { "type": "string" },
          "file": { "type": "string" },
          "line": { "type": "integer" },
          "failure": { "type": "string" },
          "summary": { "type": "string" }
        }
      }
    }
  }
}
