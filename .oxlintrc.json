{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react"],
  "categories": {
    "correctness": "error"
  },
  "options": {
    "typeAware": true
  },
  "env": {
    "builtin": true,
    "es2024": true
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/coverage/**",
    ".superpowers/**",
    "docs/**",
    "apps/api/migrations/**"
  ],
  "rules": {
    "typescript/ban-ts-comment": "error",
    "no-array-constructor": "error",
    "typescript/no-duplicate-enum-values": "error",
    "typescript/no-empty-object-type": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-extra-non-null-assertion": "error",
    "typescript/no-misused-new": "error",
    "typescript/no-namespace": "error",
    "typescript/no-non-null-asserted-optional-chain": "error",
    "typescript/no-require-imports": "error",
    "typescript/no-this-alias": "error",
    "typescript/no-unnecessary-type-constraint": "error",
    "typescript/no-unsafe-declaration-merging": "error",
    "typescript/no-unsafe-function-type": "error",
    "no-unused-expressions": "error",
    "no-unused-vars": "error",
    "typescript/no-wrapper-object-types": "error",
    "typescript/prefer-as-const": "error",
    "typescript/prefer-namespace-keyword": "error",
    "typescript/triple-slash-reference": "error",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "react/set-state-in-effect": "off",
    "react/forbid-component-props": [
      "error",
      {
        "forbid": [
          {
            "propName": "disabled",
            "disallowedFor": ["Button"],
            "message": "제출 버튼은 끄지 않는다. 누를 때 확인하고, 보내는 중에는 busy를 쓴다(AGENTS.md '화면 문구와 폼'). 권한이나 상태로 못 하는 버튼은 숨긴다."
          },
          {
            "propName": "placeholder",
            "disallowedFor": ["Input", "Textarea"],
            "message": "입력칸 안의 예시 글(placeholder)은 쓰지 않는다. 라벨을 고친다(AGENTS.md '화면 문구와 폼')."
          }
        ]
      }
    ],
    "react/forbid-dom-props": [
      "error",
      {
        "forbid": [
          {
            "propName": "placeholder",
            "message": "입력칸 안의 예시 글(placeholder)은 쓰지 않는다. 라벨을 고친다(AGENTS.md '화면 문구와 폼')."
          }
        ]
      }
    ],
    "complexity": [
      "error",
      {
        "max": 10
      }
    ],
    "max-lines-per-function": [
      "error",
      {
        "max": 50,
        "skipBlankLines": true,
        "skipComments": true
      }
    ],
    "max-lines": [
      "error",
      {
        "max": 300,
        "skipBlankLines": true,
        "skipComments": true
      }
    ],
    "max-depth": [
      "error",
      {
        "max": 4
      }
    ],
    "max-params": [
      "error",
      {
        "max": 4
      }
    ],
    "no-magic-numbers": [
      "error",
      {
        "ignore": [-1, 0, 1],
        "ignoreArrayIndexes": true,
        "ignoreDefaultValues": true,
        "ignoreTypeIndexes": true,
        "ignoreEnums": true,
        "ignoreNumericLiteralTypes": true,
        "ignoreReadonlyClassProperties": true,
        "enforceConst": true
      }
    ]
  },
  "overrides": [
    {
      "files": ["**/*.ts", "**/*.tsx"],
      "rules": {
        "typescript/await-thenable": "error",
        "typescript/no-array-delete": "error",
        "typescript/no-base-to-string": "error",
        "typescript/no-duplicate-type-constituents": "error",
        "typescript/no-floating-promises": [
          "error",
          {
            "allowForKnownSafeCalls": [
              {
                "from": "package",
                "package": "node:test",
                "name": ["describe", "it", "test"]
              }
            ]
          }
        ],
        "typescript/no-for-in-array": "error",
        "typescript/no-implied-eval": "error",
        "typescript/no-misused-promises": "error",
        "typescript/no-redundant-type-constituents": "error",
        "typescript/no-unnecessary-type-assertion": "error",
        "typescript/no-unsafe-argument": "error",
        "typescript/no-unsafe-assignment": "error",
        "typescript/no-unsafe-call": "error",
        "typescript/no-unsafe-enum-comparison": "error",
        "typescript/no-unsafe-member-access": "error",
        "typescript/no-unsafe-return": "error",
        "typescript/no-unsafe-unary-minus": "error",
        "typescript/only-throw-error": "error",
        "typescript/prefer-promise-reject-errors": "error",
        "typescript/require-await": "error",
        "typescript/restrict-plus-operands": "error",
        "typescript/restrict-template-expressions": "error",
        "typescript/unbound-method": "error"
      }
    },
    // 화면 컴포넌트는 함수 100줄. JSX는 칸 하나가 여러 줄이라 50줄은 뜻 없는 쪼개기를 부른다.
    // 줄 수 상한은 ESLint·Oxlint 권장 규칙이 아니고 결함과의 관련 근거도 약하다. 복잡도·인자·중첩 상한은 그대로다.
    {
      "files": ["**/*.tsx"],
      "rules": {
        "max-lines-per-function": [
          "error",
          {
            "max": 100,
            "skipBlankLines": true,
            "skipComments": true
          }
        ]
      }
    },
    {
      "files": ["**/*.test.ts", "**/*.test.tsx", "**/test-support/**"],
      "rules": {
        "typescript/require-await": "off",
        "max-lines-per-function": "off",
        "no-magic-numbers": "off",
        "max-lines": "off"
      }
    },
    {
      "files": ["apps/web/src/components/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/lib/api", "**/lib/api", "**/auth-client", "**/push-client"],
                "message": "src/components는 표시용 부품이다. API 호출은 기능 폴더에 둔다(AGENTS.md 화면)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/api/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@sentry/node",
                "message": "Sentry는 http/on-error.ts와 http/sentry.ts만 쓴다(AGENTS.md 로그·비밀)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/api/src/http/sentry.ts", "apps/api/src/http/sentry.test.ts"],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    // 영구 예외: 아이콘 생성기의 PNG 형식 바이트와 그림 좌표라 이름을 붙이면 형식 명세를 다시 적게 된다. 임시 목록이 아니다.
    {
      "files": ["apps/web/scripts/make-icons.mjs"],
      "rules": {
        "no-magic-numbers": "off"
      }
    }
  ]
}
