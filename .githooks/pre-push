#!/bin/sh
# 밀어내기 전에 도는 층. 게이트 넷 전부다.
#
# 커밋은 자주 하고 밀어내기는 드무므로, 느린 것은 여기 둔다. 지금은 원격이 없어서
# 실제로 돌 일이 없지만 **원격이 생기는 날 저절로 돈다** — 그때 가서 만들면 이미
# 깨진 것을 밀어낸 뒤다.
#
# 건너뛰려면 `git push --no-verify`. 건너뛰었다면 그것은 결정이지 사고가 아니어야
# 한다 — 무엇을 안 돌렸는지 알고 하는 것과 모르고 하는 것은 다르다.

set -e

echo "[pre-push] 게이트 넷 (몇 분 걸린다)"
npm run check

echo "[pre-push] 통과"
