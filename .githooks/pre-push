#!/bin/sh
# 밀어내기 전에 도는 층.
#
# **여기서 e2e를 뺀 이유(2026-08-31).**
#
# 이 훅은 원격이 없던 때 만들어졌다. 그때는 여기가 마지막 층이라 브라우저 검사까지
# 돌리는 것이 옳았고, 파일에 "원격이 생기는 날 저절로 돈다"고 적어 두었다.
#
# **원격이 생겼다.** 그리고 `.github/workflows/gate.yml`의 `browser` 작업이 e2e를
# 돌린다 — 같은 일을 두 번 하고 있었고, 그 두 번 중 느린 쪽이 남은 메모리 0.4GB인
# 이 기계였다(5.4분).
#
# 그래서 층을 나눈다.
#
# · **여기**: 빠른 것만 — 계약·화면 검사·명세 검증.
# · **CI**: 브라우저까지 전부. 남의 기계에서 도니 이 기계가 바쁜 것과 무관하다.
#
# 잃는 것: 밀어내기 전에 e2e가 깨진 것을 못 본다. 대신 CI가 몇 분 뒤에 말해 준다 —
# 이 층이 막으려던 것("깨진 것을 밀어낸 뒤에 알게 되는 것")을 없애지는 않고 조금
# 늦출 뿐이다.
#
# 전부 돌리려면 `npm run check`. 건너뛰려면 `git push --no-verify` — 건너뛰었다면
# 그것은 결정이지 사고가 아니어야 한다.

set -e

echo "[pre-push] 빠른 게이트 (e2e는 CI가 돈다)"
npm run check:fast

echo "[pre-push] 통과 — e2e는 CI의 browser 작업이 확인한다"
