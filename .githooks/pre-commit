#!/bin/sh
# 커밋마다 도는 층. 규율이 아니라 장치로 막는다.
#
# **여기서 무엇을 돌릴지는 시간이 정한다.** 게이트 전체는 지금 60~85초이고 화면이
# 85개가 되면 90~200초다(구조 감사 A). 커밋마다 그것을 돌리면 사람이 --no-verify를
# 쓰기 시작하고, 그러면 장치가 아니라 규율로 돌아간다.
#
# 그래서 이 층은 **계약을 지키는 것만** 돌린다(합쳐 5초 안팎).
# · 명세 검증 — 명세가 스스로 어긋났는가
# · 계약 검사 — 스키마·판정기·훑개·흐름이 약속대로 도는가
#
# 화면 검사(80초)와 e2e(5분)는 pre-push가 맡는다.
#
# 왜 이 둘인가. 2026-08-27 감사에서 드러난 결함 — 중첩 요소가 스키마·판정·흐름·
# 출처 추적에서 통째로 빠진 것 — 은 **정확히 이 두 층이 잡는 계급**이었다. 그런데
# 그때 계약 검사는 커밋마다 돌지 않았다.

set -e

echo "[pre-commit] 명세 검증"
node apps/spec-service/src/validate-specs.mjs

echo "[pre-commit] 계약 검사"
npm run --silent test:contracts

echo "[pre-commit] 통과"
